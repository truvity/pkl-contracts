/// What each generator writes for the awkward cases, as text. The conformance
/// suite proves that the artifacts say the same thing; these are the few that
/// only a reader of the output can see: that a default with a line break is one
/// source line, a key with a hyphen is quoted and aliased, a table row is one row.
amends "pkl:test"

import "@docs/Docs.pkl"
import "@helm/Helm.pkl"
import "@jsonschema/JsonSchema.pkl"
import "@model/Model.pkl"
import "@python/Pydantic.pkl"
import "@typescript/Zod.pkl"

import "conformance/charts/CondChart.pkl"
import "conformance/contract/Blocks.pkl"
import "conformance/contract/Conditions.pkl"
import "conformance/contract/Literals.pkl"
import "conformance/contract/Names.pkl"
import "conformance/union/Union.pkl"
import "Showcase.pkl"

local docs = Model.documents(List(Blocks, Conditions, Literals, Names, Showcase, Union))
local zod = Zod.render(docs)
local py = Pydantic.render(docs)
local reference = Docs.render(docs)
local literals = Model.moduleNode(Literals)
local function schema(key: String): Dynamic = JsonSchema.document(docs[key])

facts {
  ["a default with a line break, a tab, a quote or a separator is one escaped source line"] {
    zod.contains(#"multiline: z.string().default("first\nsecond")"#)
    zod.contains(#"spaced: z.string().default("a\tb\rc\u000cd")"#)
    zod.contains(#"quoted: z.string().default("say \"hi\" \\ bye")"#)
    zod.contains("separated: z.string().default(\"x\\u2028y\\u2029z\")")
    py.contains(#"multiline: str = Field(default="first\nsecond")"#)
    py.contains(#"spaced: str = Field(default="a\tb\rc\u000cd")"#)
    py.contains("separated: str = Field(default=\"x\\u2028y\\u2029z\")")
    // No default's own line break reached the source.
    !zod.contains("first\nsecond")
    !py.contains("first\nsecond")
  }
  ["a class documentation that ends in a quote does not close its docstring early"] {
    py.contains("\"\"\"Ends in a quote: it is called \"the end\\\"\"\"\"")
  }
  ["a key that is not an identifier is quoted in zod and aliased in pydantic"] {
    zod.contains(#"  "service-lib": NonEmptyString,"#)
    zod.contains(#"  "max-size": PositiveInt.default(10),"#)
    zod.contains(#"  global: PositiveInt.optional(),"#)
    zod.contains(#"at(o, ["the-mode"])"#)
    py.contains(#"service_lib: NonEmptyString = Field(alias="service-lib")"#)
    py.contains(#"global_: PositiveInt | None = Field(default=None, alias="global")"#)
    py.contains(#"class_: PositiveInt = Field(default=1, alias="class")"#)
    py.contains(#"f_hidden: NonEmptyString | None = Field(default=None, alias="_hidden")"#)
    py.contains(#"f_2fa: PositiveInt | None = Field(default=None, alias="2fa")"#)
    py.contains(#"max_size: PositiveInt = Field(default=10, alias="max-size")"#)
    py.contains(#"_at(self, ["the_mode"]) in"#)
  }
  ["a map keyed by an enum is a partial record in zod, and its keys are named in the schema"] {
    zod.contains("z.partialRecord(LogLevel, PositiveInt)")
    schema("literals").properties["levels"].propertyNames.`enum`
      == List("debug", "info", "warn", "error")
  }
  ["a union with a list in it keeps the items, the keys and the bound of each member"] {
    schema("union").properties["names"].anyOf.length == 2
    schema("union").properties["names"].anyOf.first.type == "array"
    schema("union").properties["names"].anyOf.first.items.minLength == 1
    schema("union").properties["sizes"].anyOf.first.items.type == "integer"
    schema("union").properties["labels"].anyOf.first.additionalProperties.type == "string"
  }
  ["a rule across the fields of a class that is not a document of its own is in its schema"] {
    schema("names").properties["gate"].allOf.length == 1
    schema("names").properties["gate"].allOf.first.then.required == List("the-key")
  }
  ["a value set at install is marked in the schema, wherever it is"] {
    schema("blocks").properties["vault"].properties["token"]["x-set-at-install"] == true
    schema("blocks").properties["vault"].required == List("token")
    !schema("blocks").properties["vault"].properties["token"].toMap().containsKey("default")
    !schema("blocks").properties["upstream"].properties["host"]
      .toMap()
      .containsKey("x-set-at-install")
  }
  ["a block that is default-complete is optional in the schema and carries its default whole"] {
    !schema("blocks").required.contains("client")
    schema("blocks").properties["client"]["default"]["retry"]["attempts"] == 3
    List("upstream", "vault", "wrapped", "deep", "volume")
      .every((k) -> schema("blocks").required.contains(k))
  }
  ["a value set at install has a structured marker in the reference"] {
    reference.contains("| `token` | NonEmptyString | yes |  |")
    reference.contains(
      "| Field | Type | Required | Default | Constraints | Description | Set at install |",
    )
    reference.contains("**Set at install.** The token. Every install supplies its own. | yes |")
  }
  ["a default with a bar, a backtick or a line break is one cell of one row"] {
    reference.split("\n").filter((l) -> l.startsWith("| `multiline`")).length == 1
    reference.contains(#"`"first\nsecond"`"#)
    reference.contains(#"`"left\|right `code`"`"#)
    Helm.readme(literals).contains(#"`"left\|right `code`"`"#)
    Helm.readme(literals).split("\n").filter((l) -> l.startsWith("| `multiline`")).length == 1
  }
  ["an exclusive bound is exclusive in every generator"] {
    schema("showcase").properties["openRatio"].exclusiveMinimum == 0
    schema("showcase").properties["openRatio"].maximum == 1
    !schema("showcase").properties["openRatio"].toMap().containsKey("minimum")
    schema("showcase").properties["halfOpen"].minimum == 0
    schema("showcase").properties["halfOpen"].exclusiveMaximum == 1
    zod.contains("openRatio: z.number().max(1).gt(0).optional()")
    zod.contains("halfOpen: z.number().min(0).lt(1).optional()")
    py.contains("openRatio: Annotated[float, Field(le=1, gt=0)] | None = None")
    py.contains("halfOpen: Annotated[float, Field(ge=0, lt=1)] | None = None")
    reference.contains("greater than 0 and at most 1")
    reference.contains("at least 0 and less than 1")
  }
  ["denied keys are a propertyNames, a refine and a validator"] {
    schema("showcase").properties["labels"].propertyNames
      == (
        new Dynamic {
          not { `enum` = List("severity", "k8s_cluster_name") }
        }
      )
    schema("showcase").properties["anyButKind"].propertyNames.not.`enum` == List("kind")
    zod.contains(
      #"labels: z.record(z.string(), NonEmptyString).refine((o) => !["severity", "k8s_cluster_name"].some"#,
    )
    py.contains(#"AfterValidator(_deny_keys(["severity", "k8s_cluster_name"]))"#)
    reference.contains("never has the keys `severity`, `k8s_cluster_name`")
  }
  ["a rule across fields through blocks is an if with then or else over nested properties"] {
    local rules = schema("conditions").allOf
    rules.length == 2
    // `when`: the condition needs every step to be there and the value to be listed.
    rules.first.`if`.required == List("mode")
    rules.first.then.properties["upstream"].required == List("url")
    // `unless`: the requirements are in the `else`, which a document that never says reaches.
    rules.last.`if`.properties["alerts"].properties["remote"].properties["enabled"].`enum`
      == List(true)
    rules.last.`if`.properties["alerts"].required == List("remote")
    !rules.last.toMap().containsKey("then")
    rules.last.`else`.required == List("database", "events", "archive")
    // Paths that share a step share its `properties`, and each level requires what runs through it.
    rules.last.`else`.properties["database"].required == List("host", "owner")
    rules.last.`else`.properties["database"].properties["owner"].required
      == List("passwordSecret")
    // A rule on a class is in the schema of the property that holds it.
    schema("conditions").properties["export"].allOf.length == 2
  }
  ["a rule across fields is a superRefine in zod and a model validator in pydantic"] {
    zod.contains(#"(["primary"] as unknown[]).includes(at(o, ["mode"]))"#)
    zod.contains(#"if (!([true] as unknown[]).includes(at(o, ["alerts", "remote", "enabled"])))"#)
    zod.contains(#"for (const p of [["database", "host"], ["database", "owner", "passwordSecret"]"#)
    zod.contains(
      "export const ConditionsExport = z.strictObject(ConditionsExport_shape).superRefine(",
    )
    py.contains(#"if _at(self, ["alerts", "remote", "enabled"]) not in [True]:"#)
    py.contains(#"if _at(self, ["mode"]) in ["primary"]:"#)
    py.contains(#"def _conditional_ConditionsExport(self) -> "ConditionsExport":"#)
    reference.contains("Rules across fields:")
    reference.contains(
      "- Unless `alerts.remote.enabled` is `true`, `database.host`, `database.owner.passwordSecret`, `events.url`, `archive.bucket.name` are required.",
    )
  }
  ["a chart's values schema carries the rules of its module"] {
    local chart = Model.chartOf(CondChart)!!
    Helm.valuesSchema(chart).allOf.length == 2
    Helm.valuesSchema(chart).allOf.first.`if`.required == List("phase")
    Helm.valuesSchema(chart).allOf.last.`else`.properties["database"].required == List("host")
  }
}
