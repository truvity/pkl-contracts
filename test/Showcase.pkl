/// One optional property per vocabulary type, so that every alias can be
/// probed on its own: this is the module the probes run against, and what
/// proves each alias's constraint and annotation agree. `ProbesTest.pkl`
/// refuses a vocabulary alias that has no property here.
@A.Schema { id = "https://example.com/contracts/test/showcase.json"; title = "showcase" }
module contracts.test.Showcase

import "@vocab/Annotations.pkl" as A
import "@vocab/Vocab.pkl" as V

port: V.Port?
percent: V.Percent?
ratio: V.Ratio?
positiveInt: V.PositiveInt?
nonNegativeInt: V.NonNegativeInt?
bytes: V.Bytes?
quantity: V.Quantity?
bufferLimit: V.BufferLimit?
duration: V.Duration?
goDuration: V.GoDuration?
promDuration: V.PromDuration?
gatewayDuration: V.GatewayDuration?
karpenterDuration: V.KarpenterDuration?
kargoDuration: V.KargoDuration?
retention: V.Retention?
seconds: V.Seconds?
days: V.Days?
openRatioAlias: V.OpenRatio?
nonEmptyString: V.NonEmptyString?
url: V.Url?
hostname: V.Hostname?
hostPort: V.HostPort?
postgresUrl: V.PostgresUrl?
httpsUrl: V.HttpsUrl?
httpUrl: V.HttpUrl?
natsUrl: V.NatsUrl?
ociUrl: V.OciUrl?
imageDigest: V.ImageDigest?
absPath: V.AbsPath?
rootedPath: V.RootedPath?
envName: V.EnvName?
httpOrigin: V.HttpOrigin?
reportUri: V.ReportUri?
collectorUrl: V.CollectorUrl?
publicKey: V.PublicKey?
urlPath: V.UrlPath?
urlPathOrEmpty: V.UrlPathOrEmpty?
dnsName: V.DnsName?
dnsLabel: V.DnsLabel?
dnsSubdomain: V.DnsSubdomain?
projectName: V.ProjectName?
installName: V.InstallName?
secretKey: V.SecretKey?
secretRefKey: V.SecretRefKey?
upstreamSecretKey: V.UpstreamSecretKey?
secretName: V.SecretName?
reload: V.Reload?
apiVersion: V.ApiVersion?
statusCodeList: V.StatusCodeList?
logLevel: V.LogLevel?
tlsMode: V.TlsMode?
gatewayTlsMode: V.GatewayTlsMode?
cspMode: V.CspMode?
pullPolicy: V.PullPolicy?
otelProtocol: V.OtelProtocol?
openObject: V.OpenObject?
named: V.Named?
mounted: V.Mounted?
nonEmptyObject: V.NonEmptyObject?

// Properties that narrow a type with their own bound (`@A.Range`, `@A.Length`),
// as a contract does where a field's rule is not worth an alias. The bound is the
// intersection of the type's and the property's, and `Check.pkl` makes Pkl
// enforce it; the probes run the same boundaries as for an alias.

/// At least ten minutes, in seconds.
@A.Range { min = 600 }
atLeastTenMinutes: V.PositiveInt?
/// At least two minutes, in seconds.
@A.Range { min = 120 }
atLeastTwoMinutes: V.PositiveInt?
/// A port, zero meaning "any free one".
@A.Range { max = 65535 }
portOrZero: V.NonNegativeInt?
/// A bound on both sides, on a plain `Int`.
@A.Range { min = -5; max = 5 }
smallInt: Int?
/// A bound on a plain `Number`.
@A.Range { min = 0.5; max = 2.5 }
smallNumber: Number?
/// A secret at least sixteen characters long.
@A.Length { min = 16 }
longEnough: V.NonEmptyString?
/// A name that is at most 253 characters, which a Kubernetes name is.
@A.Length { max = 253 }
cappedDnsName: V.DnsName?
/// Two to four characters of anything.
@A.Length { min = 2; max = 4 }
shortString: String?

// Exclusive bounds, alone and beside an inclusive one on the other end. A
// ratio that may not be zero, a duration in seconds that must be positive, a
// half-open interval.

/// Greater than zero, at most one: the vocabulary's `Ratio` with its lower end
/// made exclusive.
@A.Range { exclusiveMin = 0 }
openRatio: V.Ratio?
/// Greater than zero, no upper end.
@A.Range { exclusiveMin = 0 }
positiveNumber: Number?
/// Below one hundred, no lower end.
@A.Range { exclusiveMax = 100 }
belowHundred: Number?
/// Zero up to, and not including, one.
@A.Range { min = 0; exclusiveMax = 1 }
halfOpen: Number?
/// Whole numbers strictly between zero and ten.
@A.Range { exclusiveMin = 0; exclusiveMax = 10 }
betweenZeroAndTen: Int?

// Maps and open objects that refuse some keys.

/// Labels, but never `severity` or `k8s_cluster_name`.
@A.DenyKeys { keys { "severity"; "k8s_cluster_name" } }
labels: Mapping<String, V.NonEmptyString>?
/// An open object that is never given a `kind`.
@A.DenyKeys { keys { "kind" } }
anyButKind: V.OpenObject?

// Lists and maps with a count, and a list whose items must be distinct.

/// At least one name.
@A.Items { min = 1 }
names: Listing<String>?
/// One to three distinct log levels.
@A.Items { min = 1; max = 3; unique = true }
levels: Listing<V.LogLevel>?
/// Ports, no two alike.
@A.Items { unique = true }
ports: Listing<V.Port>?
/// Exactly two names.
@A.Items { min = 2; max = 2 }
pair: Listing<V.NonEmptyString>?
/// At most two numbers.
@A.Items { max = 2 }
fewNumbers: Listing<Int>?
/// At least one open object, no two alike.
@A.Items { min = 1; unique = true }
distinctObjects: Listing<V.OpenObject>?
/// A list of objects that each have at least one key.
objects: Listing<V.NonEmptyObject>?
/// At least one entry.
@A.Properties { min = 1 }
nonEmptyMap: Mapping<String, V.NonEmptyString>?
/// At most two entries.
@A.Properties { max = 2 }
smallMap: Mapping<String, Int>?
/// One or two keys of anything.
@A.Properties { min = 1; max = 2 }
someKeys: V.OpenObject?
