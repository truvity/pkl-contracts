/// One optional property per vocabulary type, so that every alias can be
/// probed on its own: this is the module the probes run against, and what
/// proves each alias's constraint and annotation agree. `ProbesTest.pkl`
/// refuses a vocabulary alias that has no property here.
@A.Schema { id = "https://example.com/contracts/test/showcase.json"; title = "showcase" }
module contracts.test.Showcase

import "@vocab/Annotations.pkl" as A
import "@vocab/Vocab.pkl" as V

port: V.Port?
percent: V.Percent?
ratio: V.Ratio?
positiveInt: V.PositiveInt?
nonNegativeInt: V.NonNegativeInt?
bytes: V.Bytes?
quantity: V.Quantity?
bufferLimit: V.BufferLimit?
duration: V.GoDuration?
nonEmptyString: V.NonEmptyString?
url: V.Url?
hostname: V.Hostname?
hostPort: V.HostPort?
postgresUrl: V.PostgresUrl?
imageDigest: V.ImageDigest?
absPath: V.AbsPath?
rootedPath: V.RootedPath?
envName: V.EnvName?
httpOrigin: V.HttpOrigin?
reportUri: V.ReportUri?
collectorUrl: V.CollectorUrl?
publicKey: V.PublicKey?
urlPath: V.UrlPath?
urlPathOrEmpty: V.UrlPathOrEmpty?
dnsName: V.DnsName?
logLevel: V.LogLevel?
tlsMode: V.TlsMode?
cspMode: V.CspMode?
pullPolicy: V.PullPolicy?
otelProtocol: V.OtelProtocol?
openObject: V.OpenObject?
named: V.Named?
mounted: V.Mounted?

// Properties that narrow a type with their own bound (`@A.Range`, `@A.Length`),
// as a contract does where a field's rule is not worth an alias. The bound is the
// intersection of the type's and the property's, and `Check.pkl` makes Pkl
// enforce it; the probes run the same boundaries as for an alias.

/// At least ten minutes, in seconds.
@A.Range { min = 600 }
atLeastTenMinutes: V.PositiveInt?
/// At least two minutes, in seconds.
@A.Range { min = 120 }
atLeastTwoMinutes: V.PositiveInt?
/// A port, zero meaning "any free one".
@A.Range { max = 65535 }
portOrZero: V.NonNegativeInt?
/// A bound on both sides, on a plain `Int`.
@A.Range { min = -5; max = 5 }
smallInt: Int?
/// A bound on a plain `Number`.
@A.Range { min = 0.5; max = 2.5 }
smallNumber: Number?
/// A secret at least sixteen characters long.
@A.Length { min = 16 }
longEnough: V.NonEmptyString?
/// A name that is at most 253 characters, which a Kubernetes name is.
@A.Length { max = 253 }
cappedDnsName: V.DnsName?
/// Two to four characters of anything.
@A.Length { min = 2; max = 4 }
shortString: String?
