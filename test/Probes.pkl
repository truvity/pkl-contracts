/// Boundary probes for the vocabulary, generated from the annotations.
///
/// Each alias, and each property that narrows a type with its own `@Range` or
/// `@Length`, is probed at and just outside its range, at and just outside its
/// length bounds, with its pattern's own examples, with every enum member and one
/// that is not, and with a value of the wrong type. A pattern is probed one more
/// way: each valid example with each LINE BREAK (LF, CR, FF, VT, NEL, LS, PS) at
/// its end, and the first with each at its start, must be refused, because no
/// pattern may admit one, in any engine.
///
/// The expectation comes from the ANNOTATION. `ProbesTest.pkl` runs each probe
/// against Pkl's own enforcement, so an alias whose lambda and annotation
/// disagree fails there.
///
/// Ported from the spike's `gen/Probes.pkl`, which also wrote each probe out as
/// a JSON document for the other validators; that half belongs to the
/// generators.
module contracts.test.Probes

import "@model/Model.pkl"

/// One probe: whether the value should be accepted, and the value.
class Probe {
  /// `ok` or `bad`.
  label: "ok" | "bad"

  /// What the probe is for, for a failure message.
  why: String

  /// The value to give the property.
  value: Any
}

/// A string of `n` filler characters, if the node admits it: a pattern may not.
local function fits(n: Model.Node, s: String): Boolean =
  n.pattern == null
    || (!Model.lineBreaks.any((b) -> s.contains(b)) && s.contains(Regex(n.pattern.regex)))

local function ok(reason: String, v: Any): Probe = new { label = "ok"; why = reason; value = v }
local function bad(reason: String, v: Any): Probe = new { label = "bad"; why = reason; value = v }

/// An object with each of `names` set, except `omit`.
local function keys(names: List<String>, omit: String?): Dynamic = new Dynamic {
  for (k in names) {
    when (k != omit) { [k] = "x" }
  }
}

/// The probes of a range: at and just outside each inclusive bound (one whole
/// step for an integer, a small step for a number) and, for an exclusive bound,
/// AT it (refused) and just inside and outside it.
local function rangeProbes(n: Model.Node): List<Probe> =
  let (r = n.range)
  let (e = if (n.kind == "integer") 1 else 0.001)
    (
      if (r.min != null)
        List(ok("range minimum", r.min), bad("below the range", r.min - 1))
      else
        List()
    )
      + (
        if (r.min != null && n.kind == "number")
          List(bad("just below the range", r.min - e))
        else
          List()
      )
      + (
        if (r.max != null)
          List(ok("range maximum", r.max), bad("above the range", r.max + 1))
        else
          List()
      )
      + (
        if (r.max != null && n.kind == "number")
          List(bad("just above the range", r.max + e))
        else
          List()
      )
      + (
        if (r.exclusiveMin != null)
          List(
            bad("at the exclusive minimum", r.exclusiveMin),
            ok("just above the exclusive minimum", r.exclusiveMin + e),
            bad("just below the exclusive minimum", r.exclusiveMin - e),
          )
        else
          List()
      )
      + (
        if (r.exclusiveMax != null)
          List(
            bad("at the exclusive maximum", r.exclusiveMax),
            ok("just below the exclusive maximum", r.exclusiveMax - e),
            bad("just above the exclusive maximum", r.exclusiveMax + e),
          )
        else
          List()
      )
      + List(bad("a string for a number", "1"))

/// The probes of one property's type.
function probesOf(n: Model.Node): List<Probe> =
  (
    if (n.range != null)
      rangeProbes(n)
    else
      List()
  )
    + (
      if (n.length != null)
        (
          if (n.length.min != null && n.length.min > 0 && fits(n, "x".repeat(n.length.min)))
            List(ok("minimum length", "x".repeat(n.length.min)))
          else
            List()
        )
          + (
            if (n.length.min != null && n.length.min > 0)
              List(bad("under the minimum length", "x".repeat(n.length.min - 1)))
            else
              List()
          )
          + (
            if (n.length.max != null && fits(n, "x".repeat(n.length.max)))
              List(ok("maximum length", "x".repeat(n.length.max)))
            else
              List()
          )
          + (
            if (n.length.max != null)
              List(bad("over the maximum length", "x".repeat(n.length.max + 1)))
            else
              List()
          )
          + List(bad("a number for a string", 1))
      else
        List()
    )
    + (
      if (n.pattern != null)
        n.pattern.valid.toList().map((v) -> ok("valid example", v))
          + n.pattern.invalid.toList().map((v) -> bad("invalid example", v))
          + n.pattern.valid
            .toList()
            .flatMap((v) ->
              Model.lineBreaks.mapIndexed((i, b) ->
                bad("valid example, then line break #\(i)", v + b)
              )
            )
          + Model.lineBreaks.mapIndexed((i, b) ->
            bad("line break #\(i), then valid example", b + n.pattern.valid.toList().first)
          )
      else
        List()
    )
    + (
      if (n.kind == "enum")
        n.values.map((v) -> ok("enum member", v))
          + List(bad("not a member", "not-a-member"), bad("a number for an enum", 1))
      else
        List()
    )
    + (
      if (n.kind == "string" && n.pattern == null && n.length == null)
        List(bad("a number for a string", 1))
      else
        List()
    )
    + (
      if (n.kind == "open" && n.requiresKeys != null)
        List(ok("every required key", keys(n.requiresKeys.keys.toList(), null)))
          + n.requiresKeys.keys
            .toList()
            .map((k) -> bad("without `\(k)`", keys(n.requiresKeys.keys.toList(), k)))
          + List(bad("an empty object", new Dynamic {}))
      else
        List()
    )
    + (
      if (n.kind == "open" && n.requiresKeys == null)
        List(ok("an empty object", new Dynamic {}), ok("any keys", new Dynamic { anything = 1 }))
      else
        List()
    )
    + (
      if (n.denyKeys != null)
        List(
          ok("no key", new Dynamic {}),
          ok("a key that is not denied", new Dynamic { allowed = "x" }),
        )
          + n.denyKeys.map((k) -> bad("the denied key `\(k)`", new Dynamic { [k] = "x" }))
          + List(
            bad("a denied key among others", new Dynamic { allowed = "x"; [n.denyKeys.last] = "x" }),
          )
      else
        List()
    )
    + (
      if (n.kind == "integer" && n.range == null)
        List(ok("an integer", 3), bad("a string for an integer", "3"))
      else
        List()
    )

/// Property name to its probes, for a module whose properties are all aliases.
function of(root: Model.Node): Mapping<String, List<Probe>> = new {
  for (p in root.cls.props) {
    [p.name] = probesOf(p.type)
  }
}

// ------------------------------------------------------ rules across fields

/// `c`'s properties and those of the classes it extends, the base first.
local function allProps(c: Model.Cls): List<Model.Prop> =
  (if (c.base != null) allProps(c.base.cls) else List()) + c.props

/// The property at the dotted path `path` below class `c`.
local function leaf(c: Model.Cls, path: List<String>): Model.Prop =
  let (p = allProps(c).find((x) -> x.name == path.first))
    if (path.length == 1) p else leaf(p.type.cls, path.drop(1))

/// A value that is valid for the property type `n`.
local function sample(n: Model.Node): Any =
  if (n.kind == "boolean")
    true
  else if (n.kind == "enum")
    n.values.first
  else if (n.kind == "integer" || n.kind == "number")
    n.range?.min ?? (if (n.range?.exclusiveMin != null) n.range.exclusiveMin + 1 else 1)
  else if (n.pattern != null)
    n.pattern.valid.first
  else
    "x".repeat(n.length?.min ?? 1)

/// An object with `value` at the dotted `path`.
local function nest(path: List<String>, value: Any): Dynamic = new Dynamic {
  [path.first] = if (path.length > 1) nest(path.drop(1), value) else value
}

/// Two documents laid together, objects merged where both have one.
local function merge(a: Dynamic, b: Dynamic): Dynamic =
  let (am = a.toMap())
  let (bm = b.toMap())
    new Dynamic {
      for (k, v in am) {
        when (!bm.containsKey(k)) { [k] = v }
      }
      for (k, v in bm) {
        [k] =
          if (am.containsKey(k) && am[k] is Dynamic && v is Dynamic)
            merge(am[k] as Dynamic, v)
          else
            v
      }
    }

local function mergeAll(docs: List<Dynamic>): Dynamic =
  docs.fold(new Dynamic {}, (acc, d) -> merge(acc, d))

/// The probes of one rule across fields, `d`, written on the class `c` that sits at
/// `prefix` in the document, with `base` the rest of the document needs to be valid
/// (the excuse of every `@RequiredUnless` of the module): the requirements met
/// (accepted), each one missing and all missing (refused), the rule not applying
/// (accepted) and, for an enum or a boolean, a value that is not in the list.
local function probesOfRule(
  d: Model.Condition,
  c: Model.Cls,
  prefix: List<String>,
  base: Dynamic,
  why: String,
): List<Probe> =
  let (wrap = (doc: Dynamic) -> if (prefix.isEmpty) doc else nest(prefix, doc))
  let (condition = leaf(c, d.path).type)
  let (listed = d.values.first)
  let (other = unlisted(condition, d.values))
  let (decides = (v: Any) -> wrap.apply(nest(d.path, v)))
  // What makes the requirements apply: a listed value for `when`; for `unless`, any
  // other (an absent one, or the value that is not listed).
  let (applies = if (d.unless) new Dynamic {} else decides.apply(listed))
  let (excused = if (d.unless) decides.apply(listed) else new Dynamic {})
  let (required = d.paths.map((p) -> wrap.apply(nest(p, sample(leaf(c, p).type)))))
  let (rule = "\(why): \(Model.conditionPhrase(d))")
    List(
      ok("\(rule); the requirements met", mergeAll(List(base, applies) + required)),
      bad("\(rule); all of them missing", merge(base, applies)),
      ok("\(rule); the rule not applying", merge(base, excused)),
    )
      + d.paths.mapIndexed((i, p) ->
        bad(
          "\(rule); `\(p.join("."))` missing",
          mergeAll(List(base, applies) + required.take(i) + required.drop(i + 1)),
        )
      )
      + (
        if (other == null)
          List()
        else if (d.unless)
          List(
            bad(
              "\(rule); the condition is \(other), the requirements missing",
              merge(base, decides.apply(other)),
            ),
          )
        else
          List(
            ok(
              "\(rule); the condition is \(other), nothing required",
              merge(base, decides.apply(other)),
            ),
          )
      )

/// A value of the condition's type that the rule does not list, or null.
local function unlisted(n: Model.Node, listed: List<Any>): Any =
  if (n.kind == "boolean")
    if (listed.contains(true) && !listed.contains(false))
      false
    else if (listed.contains(false) && !listed.contains(true))
      true
    else
      null
  else
    n.values.findOrNull((v) -> !listed.contains(v))

/// Probes for every rule across fields of the module `root` and of the blocks
/// directly below it, as whole documents. A document that carries each
/// `@RequiredUnless` of the module's excuse is the base of every probe, so that
/// the rule being probed is the only reason one is refused.
function conditions(root: Model.Node): List<Probe> =
  let (
    base =
      mergeAll(
        root.cls.conditions
          .filter((d) -> d.unless)
          .map((d) -> nest(d.path, d.values.first)),
      )
  )
    root.cls.conditions.flatMap((d) ->
      // Its own excuse is not in the base: it is what the probe decides.
      probesOfRule(
        d,
        root.cls,
        List(),
        mergeAll(
          root.cls.conditions
            .filter((o) -> o.unless && o != d)
            .map((o) -> nest(o.path, o.values.first)),
        ),
        "module",
      )
    )
      + root.cls.props
        .filter((p) -> p.type.kind == "object")
        .flatMap((p) ->
          p.type.cls.conditions.flatMap((d) ->
            probesOfRule(d, p.type.cls, List(p.name), base, "`\(p.name)`")
          )
        )
