// Not a package, and never published: the tests, the helpers they share, and
// the contracts and fixtures of the conformance suite (conformance/).
// It depends on the three packages by path, so a test runs against the files
// in this checkout, not against a release.
amends "pkl:Project"

tests {
  "ProbesTest.pkl"
  "LintTest.pkl"
  "ContractsTest.pkl"
  "CompatTest.pkl"
}

dependencies {
  ["vocab"] = import("../packages/vocab/PklProject")
  ["fragments"] = import("../packages/fragments/PklProject")
  ["templates"] = import("../packages/templates/PklProject")
  ["model"] = import("../packages/model/PklProject")
  ["jsonschema"] = import("../packages/jsonschema/PklProject")
  ["helm"] = import("../packages/helm/PklProject")
  ["typescript"] = import("../packages/typescript/PklProject")
  ["python"] = import("../packages/python/PklProject")
  ["docs"] = import("../packages/docs/PklProject")
}
