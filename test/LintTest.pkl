/// The authoring rules of a contract, checked by reflection.
///
/// What Pkl's reflection can see, it checks here: every declaration is
/// documented, and no field is both optional and defaulted. What it cannot see
/// (a constraint written outside the vocabulary, a stray `null`) is checked on
/// the source by `hack/lint.sh`.
///
/// The rules, from decision 0010 of the policy repository:
///
///   - there are no undocumented fields: a field's comment is its reference
///     documentation, and the generators publish it;
///   - a field with a default is optional, and an optional field is absent or
///     present with a value, so a nullable field never carries a default (the
///     two would say "optional" twice, and disagree about `null`).
amends "pkl:test"

import "pkl:reflect"

import "@fragments/Fragments.pkl"
import "@fragments/Platform.pkl"
import "@model/Model.pkl"
import "@templates/ChartValues.pkl"
import "@templates/ServiceConfig.pkl"
import "@vocab/Annotations.pkl"
import "@vocab/Check.pkl"
import "@vocab/Vocab.pkl"

import "LintFixtures.pkl"
import "Showcase.pkl"

/// Every module of the packages. The list is the module graph, because
/// `pkl:reflect` cannot enumerate one; the first fact refuses a module that is
/// missing from it.
local modules: Map<String, reflect.Module> =
  Map(
    "Annotations.pkl", reflect.Module(Annotations),
    "Vocab.pkl", reflect.Module(Vocab),
    "Check.pkl", reflect.Module(Check),
    "Fragments.pkl", reflect.Module(Fragments),
    "Platform.pkl", reflect.Module(Platform),
    "ServiceConfig.pkl", reflect.Module(ServiceConfig),
    "ChartValues.pkl", reflect.Module(ChartValues),
  )

local function documented(d: reflect.Declaration): Boolean =
  d.docComment != null && d.docComment.trim().length > 0

local function visible(p: reflect.Property): Boolean =
  !p.modifiers.contains("hidden") && !p.modifiers.contains("local")

local function propertyProblems(where: String, props: Map<String, reflect.Property>): List<String> =
  props
    .toMap()
    .filter((_, p) -> visible(p))
    .toMap()
    .entries
    .flatMap((e) ->
      (if (documented(e.second)) List() else List("\(where).\(e.first) has no doc comment"))
        + (
          if (e.second.type is reflect.NullableType && e.second.defaultValue != null)
            List(
              "\(where).\(e.first) is nullable and has a default: a default already makes a field optional",
            )
          else
            List()
        )
    )

local problems: List<String> =
  modules
    .toMap()
    .entries
    .flatMap((m) ->
      let (file = m.first)
      let (mod = m.second)
        (if (documented(mod)) List() else List("\(file) has no module doc comment"))
          + propertyProblems(file, mod.moduleClass.properties)
          + mod.classes
            .toMap()
            .entries
            .flatMap((c) ->
              (
                if (documented(c.second))
                  List()
                else
                  List("\(file) class \(c.first) has no doc comment")
              )
                + propertyProblems("\(file) class \(c.first)", c.second.properties)
            )
          + mod.typeAliases
            .toMap()
            .entries
            .flatMap((a) ->
              if (documented(a.second))
                List()
              else
                List("\(file) alias \(a.first) has no doc comment")
            )
    )

local sources: Set<String> =
  read*("../packages/{vocab,fragments,templates}/*.pkl").keys
    .map((uri) -> uri.split("/").last)
    .toSet()

facts {
  ["the lint knows every module of the packages"] {
    sources == modules.keys.toSet()
      || throw(
        "modules on disk: \(sources.toList().sort()); modules in LintTest.pkl: \(modules.keys.toList().sort())"
      )
  }
  ["every declaration is documented and no nullable field has a default"] {
    problems.isEmpty || throw("\n" + problems.join("\n"))
  }

  ["no module of the packages has a literal union used in two places, or a union with a nullable member"] {
    // `documents` refuses both (the second where it reflects a property), and
    // is what every generator starts from.
    Model.documents(List(Fragments, Platform, ServiceConfig, ChartValues, Showcase)).toMap().length
      > 0
    Model.chartOf(ChartValues) == null
  }
  ["a literal union in two places is found, and one in a single place is not"] {
    local classes =
      List("FirstUse", "SecondUse", "OnlyUse").map((c) -> Model.declNode(LintFixtures, c))
    let (ps = Model.inlineEnumProblems(classes))
      ps.length == 1
        && ps.first.contains("FirstUse.mode")
        && ps.first.contains("SecondUse.pace")
        && !ps.first.contains("OnlyUse")
    Model.inlineEnumProblems(List(Model.declNode(LintFixtures, "OnlyUse"))).isEmpty
  }
  ["`X | Y?` is refused, `(X | Y)?` is not"] {
    module
      .catch(() -> Model.declNode(LintFixtures, "Trap").cls.props.length)
      .contains("write `(X | Y)?`")
    module
      .catch(() -> Model.declNode(LintFixtures, "TrapViaAlias").cls.props.length)
      .contains("TrapAlias")
    Model.declNode(LintFixtures, "NoTrap").cls.props.first.required == false
  }
  ["set at install: nullable, a non-empty string, never defaulted; and then required"] {
    module
      .catch(() -> Model.declNode(LintFixtures, "InstallNotNullable").cls.props.length)
      .contains("nullable type")
    module
      .catch(() -> Model.declNode(LintFixtures, "InstallMayBeEmpty").cls.props.length)
      .contains("non-empty")
    module
      .catch(() -> Model.declNode(LintFixtures, "InstallWithDefault").cls.props.length)
      .contains("contradict")
    Model.declNode(LintFixtures, "Defaults").cls.props.first.required
    Model.declNode(LintFixtures, "Defaults").cls.props.first.setAtInstall
  }
  ["a property's own bound needs a number for @Range, a string for @Length, and leaves a value"] {
    module
      .catch(() -> Model.declNode(LintFixtures, "RangeOnString").cls.props.length)
      .contains("@Range is for a number")
    module
      .catch(() -> Model.declNode(LintFixtures, "LengthOnNumber").cls.props.length)
      .contains("@Length is for a string")
    module
      .catch(() -> Model.declNode(LintFixtures, "EmptyBound").cls.props.first.type.range)
      .contains("leave no value")
  }
  ["an exclusive bound is normalised, and a range that leaves no value is refused"] {
    local ranges = Model.declNode(LintFixtures, "TightenedExclusive").cls.props
    // The type's `min = 0` is dropped for the property's `exclusiveMin = 0`.
    ranges.first.type.range.min == null
    ranges.first.type.range.exclusiveMin == 0
    ranges.first.type.range.max == 1
    // Of two spellings of one end the stricter stays.
    ranges.last.type.range.min == null
    ranges.last.type.range.exclusiveMin == 0
    ranges.last.type.range.max == 1
    ranges.last.type.range.exclusiveMax == null
    module
      .catch(() -> Model.declNode(LintFixtures, "EmptyExclusive").cls.props.first.type.range)
      .contains("leave no value")
    module
      .catch(() -> Model.declNode(LintFixtures, "CrossedExclusive").cls.props.first.type.range)
      .contains("leave no value")
  }
  ["@DenyKeys is for a map or an open object"] {
    module
      .catch(() -> Model.declNode(LintFixtures, "DenyOnString").cls.props.length)
      .contains("@DenyKeys is for a map or an open object")
  }
  ["a rule across fields is resolved against the contract, and what cannot be is a generation error"] {
    module
      .catch(() -> Model.declNode(LintFixtures, "UnknownPath").cls.conditions.length)
      .contains("`typo.value` names no property")
    module
      .catch(() -> Model.declNode(LintFixtures, "ThroughScalar").cls.conditions.length)
      .contains("goes through `value`, which is NonEmptyString and not a block")
    module
      .catch(() -> Model.declNode(LintFixtures, "ConditionOnString").cls.conditions.length)
      .contains("a condition is on a boolean or an enum")
    module
      .catch(() -> Model.declNode(LintFixtures, "UnknownMember").cls.conditions.length)
      .contains("a value `mode` cannot hold")
    module
      .catch(() -> Model.declNode(LintFixtures, "StringForBoolean").cls.conditions.length)
      .contains("lists booleans")
    module
      .catch(() -> Model.declNode(LintFixtures, "DefaultInTheList").cls.conditions.length)
      .contains("defaults to true")
    module
      .catch(() -> Model.declNode(LintFixtures, "RequiredWithDefault").cls.conditions.length)
      .contains("has a default, so it is always present to Pkl")
    module
      .catch(() -> Model.declNode(LintFixtures, "ThroughDefaultedBlock").cls.conditions.length)
      .contains("has a default of its own")
    module
      .catch(() -> Model.declNode(LintFixtures, "NothingRequired").cls.conditions.length)
      .contains("`require` names nothing")
    module
      .catch(() -> Model.declNode(LintFixtures, "RuleOnAliasOfString").cls.props.length)
      .contains("for an alias of a class")
  }
  ["a sound rule is read in full: both kinds, nested paths, the converse"] {
    local conds = Model.declNode(LintFixtures, "Sound").cls.conditions
    conds.length == 2
    conds.first.unless == false
    conds.first.path == List("inner", "mode")
    conds.first.values == List("a", "b")
    conds.first.paths == List(List("inner", "value"), List("other", "x"), List("other", "y"))
    conds.last.unless
    conds.last.values == List(true)
  }
  ["a rule across fields is enforced by Pkl on a class and a module, with the paths in the message"] {
    Check.problems(new LintFixtures.Sound {}).length == 1
    Check
      .problems(new LintFixtures.Sound { inner = new LintFixtures.SoundInner { value = "v" } })
      .isEmpty
    Check
      .problems(new LintFixtures.Sound {
        inner = new LintFixtures.SoundInner { mode = "a"; value = "v" }
        other = new LintFixtures.SoundOther { x = "x" }
      })
      .length == 1
    Check
      .problems(new LintFixtures.Sound {
        inner = new LintFixtures.SoundInner { mode = "a"; value = "v" }
        other = new LintFixtures.SoundOther { x = "x"; y = "y" }
      })
      .isEmpty
    module
      .catch(() -> Check.checked(new LintFixtures.Sound {}))
      .contains("`inner.value` is required unless `flag` is `true`")
    Check.problems(new LintFixtures.Sound { flag = true }).isEmpty
  }
  ["denied keys and exclusive bounds are enforced by Pkl"] {
    Check.problems((Showcase) { labels { ["severity"] = "x" } }).length == 1
    Check.problems((Showcase) { labels { ["team"] = "x" } }).isEmpty
    Check.problems((Showcase) { anyButKind { kind = "x" } }).length == 1
    Check.problems((Showcase) { openRatio = 0 }).length == 1
    Check.problems((Showcase) { openRatio = 0.001 }).isEmpty
    Check.problems((Showcase) { halfOpen = 1 }).length == 1
    Check.problems((Showcase) { halfOpen = 0 }).isEmpty
  }
  ["an object's default is the property's own when it differs from the class's, and Pkl's when it does not"] {
    local props = Model.declNode(LintFixtures, "Defaults").cls.props
    props.find((p) -> p.name == "resources").hasDefault
    props.find((p) -> p.name == "resources").default == Map("requests", Map("cpu", "50m"))
    !props.find((p) -> p.name == "resources").required
    // An open object nobody sets is the empty one: optional, and that is its default.
    props.find((p) -> p.name == "extra").hasDefault
    props.find((p) -> p.name == "extra").default == Map()
    !props.find((p) -> p.name == "extra").required
    props.find((p) -> p.name == "limits").hasDefault
    props.find((p) -> p.name == "limits").default == Map("cpu", "2", "memory", "1Gi")
    // A class whose default is exactly its own, and whose fields all have one:
    // optional, with the instance Pkl builds.
    props.find((p) -> p.name == "plain").hasDefault
    props.find((p) -> p.name == "plain").default == Map("cpu", "1", "memory", "1Gi")
    !props.find((p) -> p.name == "plain").required
  }
  ["the line breaks the vocabulary refuses and the ones the generators guard are the same"] {
    Vocab.lineBreaks == Model.lineBreaks
    Model.lineBreaks.length == 7
    Model.lineBreaks.every((b) -> b.contains(Regex(Model.lineBreakClass)))
    !"x- _".contains(Regex(Model.lineBreakClass))
  }
  ["a pattern spells no `.`, `\\s`, `\\d`, `\\w` or `\\b`: every engine must read it alike"] {
    local patterns =
      reflect
        .Module(Vocab)
        .typeAliases
        .toMap()
        .mapValues((_, a) ->
          a.annotations.findOrNull((x) -> reflect.Class(x.getClass()).name == "Pattern")
        )
        .filter((_, a) -> a != null)
        .mapValues((_, a) -> (a as Annotations.Pattern).regex)
    patterns.length > 10
    patterns.every((name, re) ->
      portable(re) || throw("`\(name)`: \(re) uses a construct the engines read differently")
    )
  }
  ["a property's bound is enforced by Pkl, with the path and the bound in the message"] {
    local msg = module.catch(() -> Check.checked((Showcase) { atLeastTenMinutes = 599 }))
    msg.contains("atLeastTenMinutes") && msg.contains("599") && msg.contains("600")
    Check.problems((Showcase) { atLeastTenMinutes = 600; longEnough = "x".repeat(16) }).isEmpty
    Check.problems((Showcase) { longEnough = "short" }).length == 1
  }
}

/// Whether the regular expression spells no construct that ECMAScript, RE2,
/// Python and Java read differently: a `.` outside a class, or one of the
/// class escapes `\s \S \d \D \w \W \b \B` (all Unicode-aware in some engines and ASCII
/// in others). Escapes of one character (`\.`, `\t`, `\/`) are fine.
local function portable(re: String): Boolean = scan(re.chars, false)

local function scan(cs: List<String>, inClass: Boolean): Boolean =
  if (cs.isEmpty)
    true
  else if (cs.first == "\\")
    cs.length > 1 && !"sSdDwWbB".contains(cs[1]) && scan(cs.drop(2), inClass)
  else if (cs.first == "[" && !inClass)
    scan(cs.drop(1), true)
  else if (cs.first == "]" && inClass)
    scan(cs.drop(1), false)
  else if (cs.first == "." && !inClass)
    false
  else
    scan(cs.drop(1), inClass)
