/// Reads a parsed YAML document into a typed instance of a contract module,
/// so that Pkl's own enforcement (types, closed classes, alias constraints)
/// answers "is this document valid", with the two rules of decision 0010 that
/// Pkl itself is lenient about: `null` is not a value for an optional field
/// (Pkl would take it, because an optional type is nullable), and an integral
/// float is an integer (Pkl's `Int` refuses `20.0`).
///
/// Two more things Pkl's types cannot say are said here. A property that is
/// `@SetAtInstall` is nullable in Pkl, so that the module of defaults may leave
/// it out, and is REQUIRED of a document: the loader refuses a document without
/// it. And a property's own `@Range` and `@Length` are enforced by
/// `contracts.vocab.Check`, which the loaded document is passed through.
///
/// It is the oracle the conformance suite compares every other validator with,
/// and it is also what a gitops pipeline that holds its values as YAML would
/// call.
///
/// `Dynamic.toTyped` is shallow, so the nested conversion is done here by
/// reflecting on the property types.
///
/// A third place where Pkl is stricter than the others: Pkl's `Float` refuses `2`,
/// while JSON Schema's `number`, zod and pydantic accept it, as does any JSON
/// reader. The loader widens it, so that the oracle says what a document means.
module contracts.test.Load

import "pkl:reflect"

import "@vocab/Check.pkl"

local function conv(v: Any, t: reflect.Type): Any =
  if (v == null)
    null
  else if (t is reflect.NullableType)
    conv(v, t.member)
  else if (t is reflect.UnionType)
    // A union is read as the member whose shape the value has: a list as a
    // Listing, an object as a Mapping or a class whose properties its keys are
    // (Pkl's own check follows).
    let (m = t.members.findOrNull((m) -> shaped(v, m)))
      if (m == null) v else conv(v, m)
  else if (t is reflect.DeclaredType)
    declared(v, t)
  else
    v

/// Whether a parsed value has the shape of type `t`: only the two composite
/// shapes a document has, a list and an object.
local function shaped(v: Any, t: reflect.Type): Boolean =
  if (t is reflect.NullableType)
    shaped(v, t.member)
  else if (t is reflect.DeclaredType)
    let (r = t.referent)
      if (r is reflect.TypeAlias)
        shaped(v, r.referent)
      else if (r.enclosingDeclaration.uri == "pkl:base")
        if (v is Listing)
          r.name == "Listing"
        else if (v is Dynamic)
          r.name == "Mapping" || r.name == "Dynamic"
        else
          false
      else
        // A class member of a union: an object whose keys the class has, so that a
        // document of the second class is not read as the first.
        v is Dynamic
          && v.toMap().keys.every((k) -> (r as reflect.Class).allProperties.containsKey(k))
  else
    false

local function declared(v: Any, t: reflect.DeclaredType): Any =
  let (r = t.referent)
    if (r is reflect.TypeAlias)
      conv(v, r.referent)
    else if (r.enclosingDeclaration.uri == "pkl:base")
      if (r.name == "Int" && v is Float && !v.isNaN && !v.isInfinite && v == v.truncate())
        v.toInt()
      else if (r.name == "Float" && v is Int)
        // JSON has one kind of number: 2 is as good a float as 2.0 (Pkl's `Float`
        // refuses an `Int`).
        v.toFloat()
      else if (r.name == "Listing" && v is Listing)
        new Listing { for (e in v) { conv(e, t.typeArguments[0]) } }
      else if (r.name == "Mapping" && v is Dynamic)
        new Mapping { for (k, e in v.toMap()) { [k] = conv(e, t.typeArguments[1]) } }
      else
        v
    else
      typed(v, r as reflect.Class)

local function named(a: Annotation, name: String): Boolean =
  let (c = reflect.Class(a.getClass()))
    c.name == name && c.enclosingDeclaration.name == "contracts.vocab.Annotations"

local function typed(v: Any, c: reflect.Class): Any =
  if (v is Dynamic)
    let (props = c.allProperties.toMap().filter((_, p) -> !p.modifiers.contains("hidden")))
    let (extra = v.toMap().keys.filter((k) -> !props.containsKey(k)))
    let (nulls = v.toMap().filter((_, e) -> e == null).keys)
    // Pkl gives an absent object property the default of its class, so a nested
    // `@SetAtInstall` (or a required field) inside it would go unnoticed. Reading
    // the absent object as an empty document finds it; the result is discarded,
    // because the object's own default is Pkl's to apply.
    let (
      absent =
        props
          .filter((k, p) -> !v.toMap().containsKey(k) && !(p.type is reflect.NullableType))
          .mapValues((_, p) -> conv(new Dynamic {}, p.type))
    )
    let (
      unset =
        props
          .filter((_, p) -> p.annotations.any((a) -> named(a, "SetAtInstall")))
          .keys
          .filter((k) -> !v.toMap().containsKey(k))
    )
      if (absent.length < 0)
        throw("unreachable")
      else if (!unset.isEmpty)
        throw("`\(unset.first)` in class `\(c.name)` is set at install: the document must set it")
      else if (!extra.isEmpty)
        throw("Cannot find property `\(extra.first)` in class `\(c.name)`")
      else if (!nulls.isEmpty)
        throw("`\(nulls.first)` in class `\(c.name)` is null: null is not a value, omit the key")
      else
        v
          .toMap()
          .mapValues((k, e) -> if (props.containsKey(k)) conv(e, props[k].type) else e)
          .toDynamic()
          .toTyped(c.reflectee)
  else
    v

/// The instance of module `m` that `data` (parsed YAML) denotes.
function load(m: Module, data: Any): Any =
  if (data is Dynamic)
    Check.checked(typed(data, reflect.Module(m).moduleClass))
  else
    throw("a configuration document must be an object")
