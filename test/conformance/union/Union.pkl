/// A property that is one of several shapes, a list among them: the schema must
/// check the items of the list as the contract's own type does, not only that
/// it is an array. Kept apart from `contract/` because the Kotlin generator
/// refuses a union type, as it does for the platform block.
@A.Schema { id = "https://example.com/schemas/union.json"; title = "union" }
module conformance.union.Union

import "@vocab/Annotations.pkl" as A
import "@vocab/Vocab.pkl" as V

/// One name, or several.
names: (Listing<V.NonEmptyString> | V.NonEmptyString)?

/// A number, or a list of whole numbers.
sizes: (Listing<Int> | Number)?

/// A string, or a map of strings.
labels: (Mapping<String, String> | String)?

/// A list of names, each either a bare name or an object that carries labels: a
/// string and a block in one position, which JSON Schema says as `anyOf` (the
/// members cannot overlap, so `oneOf` would accept the same documents).
namespaces: Listing<V.NonEmptyString | Namespace>?

/// Two closed classes with nothing required: the empty object conforms to both
/// members, which `anyOf` accepts as Pkl does, and `oneOf` would refuse.
either: (First | Second)?

/// False, or a namespace: `false` says there is none to render, an object says
/// what it is. `true` is neither, which `Boolean | Namespace` would admit.
namespace: (V.FalseOnly | Namespace)?

/// A namespace with labels.
class Namespace {
  /// The namespace's name.
  name: V.NonEmptyString

  /// Labels to put on it.
  labels: Mapping<String, String>?
}

/// One shape of `either`.
class First {
  /// A number only this shape has.
  a: Int?
}

/// The other shape of `either`.
class Second {
  /// A number only this shape has.
  b: Int?
}
