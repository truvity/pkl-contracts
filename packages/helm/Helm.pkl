/// Helm artifacts from a chart's values contract: `values.schema.json`, composed
/// so that Helm validates offline (every document the values refer to is
/// embedded under `$defs` by its `$id`, which Helm cannot fetch), the defaults
/// as `values.yaml`, and a table of every value for the README.
module contracts.helm.Helm

import "@jsonschema/JsonSchema.pkl"
import "@model/Model.pkl"

/// The composed schema of a chart whose values class is `root`.
///
/// `$defs` holds the documents the values refer to, each by its `$id`, and the
/// chart's own `@Def` definitions, each by its name, so that a
/// `$ref: "#/$defs/<name>"` in the chart's values resolves. A definition used only
/// inside a document is in that document's own `$defs`. The key is left out when
/// there is nothing to put in it: an empty `$defs` says nothing.
function valuesSchema(root: Model.Node): Dynamic =
  let (
    docs =
      Model
        .walk(root)
        .filter((n) -> n.schema != null)
        .distinctBy((n) -> n.schema.id)
  )
  let (
    defs =
      Model
        .walkOwn(root)
        .filter((n) -> n.def != null)
        .distinctBy((n) -> n.def.name)
  )
    new Dynamic {
      ["$schema"] = JsonSchema.schemaUri
      title = root.chart.title
      when (root.cls.doc != null) { description = root.cls.doc }
      ...JsonSchema.objectBody(root.cls, "additionalProperties")
      when (!JsonSchema.conditions(root.cls).isEmpty) {
        allOf = JsonSchema.conditions(root.cls)
      }
      when (!docs.isEmpty || !defs.isEmpty) {
        ["$defs"] = new Dynamic {
          for (d in docs) {
            [d.schema.id] = JsonSchema.documentIn(d, false)
          }
          for (d in defs) {
            [d.def.name] = JsonSchema.definition(d)
          }
        }
      }
    }

/// The chart's default values, from a module that amends its contract. What is
/// rendered is the module's own `output.value`, which a template makes the module
/// checked against the bounds its properties carry (`contracts.vocab.Check`), so
/// a default that breaks one fails here as it does under `pkl eval`.
function valuesYaml(values: Module): String =
  new YamlRenderer {}.renderDocument(values.output.value)

/// One row of the values table.
class Row {
  /// The dotted path of the value.
  path: String

  /// What kind of value it is.
  type: String

  /// The default, as written in a document, or empty.
  default: String

  /// Whether the value must be given: required, and so is everything it is in.
  required: Boolean

  /// Whether the value is required of the install and absent from the defaults.
  setAtInstall: Boolean

  /// What the contract says about it.
  doc: String
}

local function firstParagraph(d: String?): String =
  (d ?? "").split("\n\n").first.replaceAll("\n", " ").replaceAll("|", "\\|")

local function rows(prefix: String, p: Model.Prop, within: Boolean): List<Row> =
  let (dotted = if (prefix == "") p.name else "\(prefix).\(p.name)")
  let (t = p.type)
    if (t.kind == "object" && !t.cls.props.isEmpty)
      t.cls.props.flatMap((c) -> rows(dotted, c, within && p.required))
    else if (t.kind == "map" && t.items.kind == "object" && !t.items.cls.props.isEmpty)
      t.items.cls.props.flatMap((c) -> rows("\(dotted).<name>", c, false))
    else
      List(new Row {
        path = dotted
        type = Model.typeLabel(t) + (if (p.nullable) " | null" else "")
        default = if (p.hasDefault) "`\(Model.literal(p.default).replaceAll("|", "\\|"))`" else ""
        required = within && p.required
        setAtInstall = p.setAtInstall
        doc = firstParagraph(p.doc)
      })

/// A Markdown table of every value of the chart.
function readme(root: Model.Node): String =
  let (all = root.cls.props.flatMap((p) -> rows("", p, true)))
    """
    <!-- Generated from the chart's values contract. Do not edit. -->

    ## Values

    | Key | Type | Default | Description |
    |---|---|---|---|
    \(all.map((r) -> "| `\(r.path)` | \(r.type.replaceAll("|", "\\|")) | \(r.default) | \(if (r.setAtInstall) "**Set at install.** " else if (r.required) "**Required.** " else "")\(r.doc) |").join("\n"))

    """
