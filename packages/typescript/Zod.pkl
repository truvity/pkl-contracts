/// TypeScript types and zod (v4) schemas from the intermediate form.
///
/// Choices, each one a rule of decision 0010:
///
///   - a closed class is a strict object, so an undeclared key is an error;
///   - an optional property is absent, never `null`: zod's `.optional()` takes
///     `undefined` only, so `null` is refused;
///   - a field with a default is optional, and is given its default with
///     `.default()`;
///   - an integral float is an integer: JavaScript has one number type, so
///     `20.0` is `20`, and `.int()` accepts it;
///   - a pattern is a search that never admits a line break: a JavaScript
///     regular expression is a search already, and `$` does not match before a
///     final newline there, but a pattern with no `$` would, and `$` and `.` stop
///     at other line breaks in other engines, so every pattern is paired with a
///     refinement that refuses any of them (LF, CR, FF, VT, NEL, LS, PS);
///   - a default is any JSON value, an object included;
///   - a map keyed by an enum is a partial record: only the members it names;
///   - a property whose name is not an identifier (`service-lib`) is a quoted key,
///     and is read as `at(o, ["service-lib"])` where the module reads it;
///   - a rule across fields (`@RequiredWhen`, `@RequiredUnless`) is a
///     `superRefine`, which reads a dotted path through `at` (absent on the way
///     is absent) and reports each missing path at that path;
///   - `@DenyKeys` is a `refine` that refuses an own key on the list;
///   - an exclusive bound is `.gt()` or `.lt()`;
///   - `@Items` is `.min()` and `.max()` on the array, and `uniqueItems` a
///     `refine` that compares the items as JSON with the keys of an object in
///     order (`distinct`), so that two objects that differ only in the order of
///     their keys are one item, as JSON Schema has it;
///   - `@Properties` is a `refine` that counts the own keys (`sized`): zod has no
///     bound on the size of a record or an object;
///   - `@NotPattern` is a `refine` that refuses a match, with the rule's reason as
///     its message;
///   - a union is `z.union`, which, like JSON Schema's `anyOf`, accepts a value
///     that is any member (see `JsonSchema`);
///   - `@Nullable` is `.nullable()` on the property (and it stays optional, or
///     keeps its default); `@MultiLine` leaves out the `noLineBreak` refinement
///     of its node; `@OneOfValues` is a `refine` that tests membership.
///
/// Every class and alias is exported twice, as the schema and as the type
/// (`z.infer`), under one name. A reference between classes is lazy, so the
/// order of declarations does not matter.
module contracts.typescript.Zod

import "@model/Model.pkl"

local function jsdoc(d: String?, indent: String): String =
  if (d == null) "" else "\(indent)/** \(d.replaceAll("*/", "*\\/").replaceAll("\n", " ")) */\n"

/// One character of a string written inside double quotes in source: a quote, a
/// backslash and every control character or line separator (a raw line feed ends
/// a TypeScript or Python string) as an escape both languages read alike.
local function escapeChar(c: String): String =
  if (c == "\\")
    "\\\\"
  else if (c == "\"")
    "\\\""
  else if (c == "\n")
    "\\n"
  else if (c == "\r")
    "\\r"
  else if (c == "\t")
    "\\t"
  else
    let (cp = c.codePoints.first)
      if (cp < 32 || (cp >= 127 && cp <= 159) || cp == 8232 || cp == 8233)
        "\\u" + cp.toRadixString(16).padStart(4, "0")
      else
        c

/// A string as a double-quoted literal.
local function quote(v: String): String = "\"" + v.chars.map((c) -> escapeChar(c)).join("") + "\""

local function lit(v: Any): String =
  if (v is String)
    quote(v)
  else if (v is List)
    "[\(v.map((e) -> lit(e)).join(", "))]"
  else if (v is Map)
    "{\(v.entries.map((e) -> "\(lit(e.first)): \(lit(e.second))").join(", "))}"
  else
    "\(v)"

/// A property name as an object key: bare when it is an identifier, quoted
/// when it is not (`service-lib`).
local function key(name: String): String =
  if (name.matches(Regex("[A-Za-z_$][A-Za-z0-9_$]*"))) name else lit(name)

/// Reading property `name` of an object `o`.
local function access(o: String, name: String): String =
  if (name.matches(Regex("[A-Za-z_$][A-Za-z0-9_$]*"))) "\(o).\(name)" else "\(o)[\(lit(name))]"

local function regex(r: String): String = "/\(r.replaceAll("/", "\\/"))/"

local function range(n: Model.Node): String =
  (if (n.range?.min != null) ".min(\(n.range.min))" else "")
    + (if (n.range?.max != null) ".max(\(n.range.max))" else "")
    + (if (n.range?.exclusiveMin != null) ".gt(\(n.range.exclusiveMin))" else "")
    + (if (n.range?.exclusiveMax != null) ".lt(\(n.range.exclusiveMax))" else "")

/// A refinement that admits only the numbers `@OneOfValues` lists, or nothing.
local function oneOf(n: Model.Node): String =
  if (n.numericValues == null)
    ""
  else
    ".refine((x) => [\(n.numericValues.map((v) -> lit(v)).join(", "))].includes(x), { message: \(lit("must be one of " + n.numericValues.map((v) -> "\(v)").join(", "))) })"

/// `.min()`, `.max()` and the uniqueness refinement of an array's `@Items`, or
/// nothing.
local function itemBounds(n: Model.Node): String =
  (if (n.itemBounds?.min != null) ".min(\(n.itemBounds.min))" else "")
    + (if (n.itemBounds?.max != null) ".max(\(n.itemBounds.max))" else "")
    + (
      if (n.itemBounds?.unique == true)
        ".refine(distinct, { message: \"items must be distinct\" })"
      else
        ""
    )

/// A refinement for the number of entries `@Properties` bounds, or nothing.
local function propertyBounds(n: Model.Node): String =
  (
    if (n.propertyBounds?.min != null)
      ".refine((o) => sized(o) >= \(n.propertyBounds.min), { message: \(lit("must have at least \(n.propertyBounds.min) \(if (n.propertyBounds.min == 1) "entry" else "entries")")) })"
    else
      ""
  )
    + (
      if (n.propertyBounds?.max != null)
        ".refine((o) => sized(o) <= \(n.propertyBounds.max), { message: \(lit("must have at most \(n.propertyBounds.max) \(if (n.propertyBounds.max == 1) "entry" else "entries")")) })"
      else
        ""
    )

/// A refinement that refuses the keys `@DenyKeys` lists, or nothing.
local function denied(n: Model.Node): String =
  if (n.denyKeys == null)
    ""
  else
    ".refine((o) => ![\(n.denyKeys.map((k) -> lit(k)).join(", "))].some((k) => Object.prototype.hasOwnProperty.call(o, k)), { message: \(lit("must not have the key " + n.denyKeys.map((k) -> "`\(k)`").join(" or "))) })"

/// The zod expression for a node, referring to aliases and classes by name.
local function expr(n: Model.Node): String =
  if (n.kind == "object")
    "z.lazy(() => \(n.alias ?? n.cls.qname))"
  else if (n.alias != null)
    n.alias
  else
    inner(n)

local function inner(n: Model.Node): String =
  if (n.kind == "string")
    "z.string()"
      + (if (n.length?.min != null) ".min(\(n.length.min))" else "")
      + (if (n.length?.max != null) ".max(\(n.length.max))" else "")
      + (
        if (n.pattern == null)
          ""
        else if (n.multiLine)
          ".regex(\(regex(n.pattern.regex)))"
        else
          ".regex(\(regex(n.pattern.regex))).refine(noLineBreak)"
      )
      + n.notPatterns
        .map((p) -> ".refine((s) => !\(regex(p.regex)).test(s), { message: \(lit(p.reason)) })")
        .join("")
  else if (n.kind == "integer")
    "z.number().int()" + range(n) + oneOf(n)
  else if (n.kind == "number")
    "z.number()" + range(n) + oneOf(n)
  else if (n.kind == "boolean")
    "z.boolean()"
  else if (n.kind == "enum")
    "z.enum([\(n.values.map((v) -> lit(v)).join(", "))])"
  else if (n.kind == "list")
    "z.array(\(expr(n.items)))" + itemBounds(n)
  else if (n.kind == "map")
    // zod 4 reads a record keyed by an enum as exhaustive (every member needed),
    // which a map is not: a partial record names the members it may have.
    "z.\(if (n.key.kind == "enum") "partialRecord" else "record")(\(expr(n.key)), \(expr(n.items)))"
      + propertyBounds(n)
      + denied(n)
  else if (n.kind == "open")
    "z.looseObject({})"
      + (
        if (n.requiresKeys == null)
          ""
        else
          ".refine((o) => [\(n.requiresKeys.keys.toList().map((k) -> lit(k)).join(", "))].every((k) => k in o))"
      )
      + propertyBounds(n)
      + denied(n)
  else if (n.kind == "union")
    "z.union([\(n.members.map((m) -> expr(m)).join(", "))])"
  else
    "z.unknown()"

local function field(p: Model.Prop): String =
  jsdoc(p.doc, "  ")
    + "  \(key(p.name)): \(expr(p.type))\(if (p.nullable) ".nullable()" else "")"
    + (
      if (p.hasDefault)
        ".default(\(lit(p.default)))"
      else if (!p.required)
        ".optional()"
      else
        ""
    )
    + ",\n"

/// The rules across fields of `c` and of the classes it extends, the base's
/// first: a class is spread from its base's shape, which carries no refinement.
local function allConditions(c: Model.Cls): List<Model.Condition> =
  (if (c.base != null) allConditions(c.base.cls) else List()) + c.conditions

/// A path as an array of keys.
local function pathLit(p: List<String>): String = "[\(p.map((k) -> lit(k)).join(", "))]"

/// The refinements for rules across fields: one `superRefine` that reads each
/// condition's path and, where the rule applies, reports every required path
/// that is absent, at that path.
local function conditionRefine(conds: List<Model.Condition>): String =
  if (conds.isEmpty)
    ""
  else
    ".superRefine((o, ctx) => {\n"
      + conds
        .map((d) ->
          "    if (\(if (d.unless) "!" else "")(\(lit(d.values)) as unknown[]).includes(at(o, \(pathLit(d.path))))) {\n"
            + "      for (const p of \(pathLit2(d.paths))) {\n"
            + "        if (at(o, p) === undefined) ctx.addIssue({ code: \"custom\", path: p, message: \(lit(Model.conditionPhrase(d))) });\n"
            + "      }\n"
            + "    }\n"
        )
        .join("")
      + "  })"

local function pathLit2(ps: List<List<String>>): String =
  "[\(ps.map((p) -> pathLit(p)).join(", "))]"

local function classDef(c: Model.Cls): String =
  jsdoc(c.doc, "")
    + "export const \(c.qname)_shape = {\n"
    + (if (c.base != null) "  ...\(c.base.cls.qname)_shape,\n" else "")
    + c.props.map((p) -> field(p)).join("")
    + "};\n"
    + "export const \(c.qname) = z.\(if (c.isOpen) "looseObject" else "strictObject")(\(c.qname)_shape)\(conditionRefine(allConditions(c)));\n"
    + "export type \(c.qname) = z.infer<typeof \(c.qname)>;\n\n"

local function aliasDef(n: Model.Node): String =
  jsdoc(n.doc, "")
    + "export const \(n.alias) = \(inner(n));\n"
    + "export type \(n.alias) = z.infer<typeof \(n.alias)>;\n"

local function classAliasDef(n: Model.Node): String =
  jsdoc(n.doc, "")
    + "export const \(n.alias) = \(n.cls.qname)"
    + conditionRefine(n.conditions)
    + ";\n"
    + "export type \(n.alias) = z.infer<typeof \(n.alias)>;\n\n"

local header: String =
  """
  // Generated from a contract by contracts.typescript. Do not edit.
  import { z } from "zod";

  const noLineBreak = (s: string): boolean => !/[\\n\\r\\f\\v\\u0085\\u2028\\u2029]/.test(s);

  // The number of own keys of an object or a record.
  const sized = (o: object): number => Object.keys(o).length;

  // JSON with the keys of every object in order, so that two values that differ
  // only in the order of an object's keys are one value (JSON Schema's equality).
  const canon = (v: unknown): string =>
    JSON.stringify(v, (_k, x) =>
      x !== null && typeof x === "object" && !Array.isArray(x)
        ? Object.fromEntries(Object.entries(x).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)))
        : x,
    );

  // Whether no two items are equal.
  const distinct = (a: unknown[]): boolean => new Set(a.map(canon)).size === a.length;

  // The value at a path through blocks; absent on the way is absent.
  const at = (o: unknown, path: string[]): unknown => {
    let v: unknown = o;
    for (const k of path) {
      if (v === null || v === undefined) return undefined;
      v = (v as Record<string, unknown>)[k];
    }
    return v;
  };


  """

/// The TypeScript module for the documents in `roots`.
function render(roots: Mapping<String, Model.Node>): String =
  let (ns = roots.toMap().values.toList())
    header
      + Model.aliases(ns).map((a) -> aliasDef(a)).join("")
      + "\n"
      + Model.classes(ns).map((c) -> classDef(c.cls)).join("")
      + Model.classAliases(ns).map((a) -> classAliasDef(a)).join("")
      + "export const schemas = {\n"
      + roots
        .toMap()
        .entries
        .map((e) -> "  \(lit(e.first)): \(e.second.alias ?? e.second.cls.qname),\n")
        .join("")
      + "} as const;\n"
