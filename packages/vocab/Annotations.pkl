/// The annotations a generator reads. They sit in their own module so that a
/// language generator which wants only the types (Go, Kotlin) need not generate
/// them: `pkl-codegen-kotlin` otherwise demands the generated `pkl:base`. Do not
/// move them back into `Vocab.pkl`.
module contracts.vocab.Annotations

/// Marks a module, class or alias as a standalone JSON Schema document.
class Schema extends Annotation {
  /// The document's `$id`.
  id: String

  /// The document's `title`.
  title: String?
}

/// A numeric range. `min` and `max` are inclusive, `exclusiveMin` and
/// `exclusiveMax` are not (`exclusiveMin = 0` is "greater than zero"), and each
/// side may carry either, or both (the stricter holds). On an alias it is the
/// alias's own range; on a PROPERTY it narrows the type the property has (the two
/// are intersected, so a property can only tighten what its type already says),
/// and `Check.pkl` makes Pkl enforce it: Pkl itself has no constraint a property
/// could carry. A range that leaves no value (`min` above `max`, or the two
/// meeting where either side is exclusive) is refused when the contract is
/// reflected.
class Range extends Annotation {
  /// The least value allowed. Absent means unbounded.
  min: Number?

  /// The greatest value allowed. Absent means unbounded.
  max: Number?

  /// The value the number must be greater than. Absent means no such bound.
  exclusiveMin: Number?

  /// The value the number must be less than. Absent means no such bound.
  exclusiveMax: Number?
}

/// A string length bound. Like `Range`, it is an alias's own, or, on a property,
/// narrows the property's type and is enforced by `Check.pkl`.
class Length extends Annotation {
  /// The fewest characters allowed. Absent means unbounded.
  min: Int?

  /// The most characters allowed. Absent means unbounded.
  max: Int?
}

/// A regular expression with JSON Schema `pattern` semantics: it may match
/// ANYWHERE in the string. Pkl's `String.matches` is a FULL match, so an alias
/// that constrains with `matches(Regex(...))` and annotates a prefix pattern
/// such as `^/` would accept less than its schema says; the probes caught
/// exactly that on the first run. Aliases use `contains(Regex(...))`.
///
/// A pattern must not admit a newline. Engines disagree on whether `$` matches
/// before a final `\n`, so no pattern may rely on either answer: the alias
/// refuses any value that contains one, and a generator must say the same in
/// its own output (a JSON Schema pairs `pattern` with a clause refusing `\n`).
/// The probes check both directions.
///
/// Also carries the examples a probe uses to check the alias's constraint and
/// this annotation still agree. The probes extend each `valid` value with a
/// newline to prove the rule above.
class Pattern extends Annotation {
  /// The expression, with JSON Schema `pattern` (search) semantics.
  regex: String

  /// Values the alias accepts. At least one.
  valid: Listing<String>(!isEmpty)

  /// Values the alias refuses. At least one.
  invalid: Listing<String>(!isEmpty)
}

/// A regular expression the value must NOT match (JSON Schema `not: { pattern }`).
/// Search semantics, like `Pattern`. An alias may carry several, one for each
/// rule, each with the reason a person is told. The alias also enforces the same
/// expressions as a Pkl constraint, from one `local const` list that both name, so
/// that Pkl and a generator say the same; the probes check that each `invalid`
/// example is refused. `Pattern` says what a value looks like, `NotPattern` what
/// it must never contain (a password in a connection URL, say), and an alias that
/// has both admits a value that matches the first and none of the second.
class NotPattern extends Annotation {
  /// The expression the value must not match, with JSON Schema `pattern` (search)
  /// semantics.
  regex: String

  /// Why: what is wrong with a value that matches, and where it belongs instead.
  reason: String

  /// Values the alias refuses because of this rule. At least one.
  invalid: Listing<String>(!isEmpty)
}

/// A bound on the number of items of a `Listing` or a `List`, and whether they
/// must be distinct. JSON Schema `minItems`, `maxItems` and `uniqueItems`; zod
/// `.min()`, `.max()` and a refinement; pydantic `min_length`, `max_length` and a
/// validator. On an alias it is the alias's own; on a PROPERTY it narrows the type
/// the property has (the tighter bound of each end, and a set stays a set), and
/// `Check.pkl` makes Pkl enforce it, as it does `Range` and `Length`: Pkl has no
/// constraint a property could carry, and a constraint written on the type
/// (`Listing<String>(length >= 1)`) is invisible to reflection, so a generator
/// could not read it. Items are distinct when JSON values compare equal, whatever
/// the order of an object's keys.
class Items extends Annotation {
  /// The fewest items allowed. Absent means unbounded.
  min: Int?

  /// The most items allowed. Absent means unbounded.
  max: Int?

  /// Whether no two items may be equal.
  unique: Boolean = false
}

/// A bound on the number of entries of a `Mapping` or of keys of an open object:
/// JSON Schema `minProperties` and `maxProperties`. Like `Items`, it is an
/// alias's own, or, on a property, narrows the property's type and is enforced by
/// `Check.pkl`.
class Properties extends Annotation {
  /// The fewest entries allowed. Absent means unbounded.
  min: Int?

  /// The most entries allowed. Absent means unbounded.
  max: Int?
}

/// A property the schema REQUIRES and a chart's default values leave out: a
/// bucket name, a host, a password Secret. A default of `""` would pass a
/// `NonEmptyString` only by not being one, and would let an install that forgot
/// the value fail somewhere else, later; so the key is absent from the defaults
/// (`values.yaml`) and the schema refuses a document that does not set it.
///
/// Put it on a property whose type is a NON-EMPTY string alias (the schema's
/// requirement of a value is then a requirement of a real one) and which is
/// nullable in Pkl (`V.NonEmptyString?`), so that the module that holds the
/// defaults need not set it. The annotation is what turns "nullable" into
/// "required" for every generator and for the test loader. It is never
/// combined with a default.
class SetAtInstall extends Annotation {}

/// A property the document MUST carry and that has no default, with nothing else
/// said about it: no `x-set-at-install` key, and no claim that an install is what
/// supplies it. It is `@SetAtInstall` for the cases that are not "set at install":
/// a list the caller must give (a CA bundle, a set of roles), an open object a
/// chart takes whole, a number with no sensible default. Pkl has no way to say it
/// otherwise: a `Listing` or a `Dynamic` always has an implicit default (the empty
/// one), and a property typed `T?` is optional.
///
/// Write the property `T?` in Pkl, so that the module that holds the defaults need
/// not set it, and annotate it; every generator and the test loader then require
/// it. It is never combined with a default or with `@Nullable` (a property that
/// must be present AND may be `null` is a value the contract has to decide on).
/// Unlike `@SetAtInstall` it asks nothing of the type: a string may be empty if its
/// type admits `""`.
///
/// `@SetAtInstall` stays the spelling for a value only an install can give: it
/// additionally marks the property `x-set-at-install: true` in a JSON Schema and
/// "Set at install" in the reference, which tools read to find what a chart's
/// defaults leave out.
class Required extends Annotation {}

/// A property that admits the JSON value `null` as well as its type, and is still
/// optional: the key may be absent, or present with a value, or present with
/// `null`. This is not what an optional property is by default: `T?` means
/// "absent", and `null` is refused as a type error by every validator (decision
/// 0010), because a document that says `x: null` and one that says nothing would
/// otherwise be two spellings of one thing. A value that means something by
/// itself, as `instances: null` for "the profile decides", is declared.
///
/// On a PROPERTY whose Pkl type is nullable (`Int?`). The JSON Schema is
/// `type: [<t>, "null"]` where the type is a plain keyword (and `"null"` is also
/// appended to an `enum`), and `anyOf: [<schema>, { type: "null" }]` where it is
/// not (a `$ref`, or a union that is already an `anyOf`): both are accepted by
/// every engine of the conformance suite and mean the same thing. zod adds
/// `.nullable()` and pydantic `| None`, with the `null` check of the model lifted
/// for this key.
///
/// The rest of the property's schema (`minimum`, `pattern`, `items`) applies to a
/// non-null value only, as in JSON Schema. Not on an alias: whether a property
/// takes `null` is the property's business, not the type's.
class Nullable extends Annotation {}

/// The numbers a numeric property may be. Pkl's literal types are strings, so a
/// set of numbers is stated here: JSON Schema `enum` (and `type: integer` or
/// `number`), zod a refinement, pydantic a validator. On an alias it is the
/// alias's own and the alias also writes the set as its Pkl constraint; on a
/// PROPERTY it narrows the type it has (the intersection of the two lists) and
/// `Check.pkl` makes Pkl enforce it. It combines with `@Range` (both hold) and with
/// `@Nullable` (`null` is then a member of the `enum` as well as of the type).
///
/// A set of strings is a literal union (`"a" | "b"`), not this.
class OneOfValues extends Annotation {
  /// The numbers allowed. At least one, and each an integer where the type is.
  values: List<Number>(!isEmpty)
}

/// A string alias or property that is legitimately more than one line, such as a
/// PEM bundle matched by an unanchored `@Pattern`. Every `pattern` is paired, by
/// default, with a clause that refuses all seven line breaks (see the `Pattern`
/// annotation): engines disagree about what `$` and `.` do at a line break, so a
/// pattern cannot be trusted to refuse one, and the default is that a value never
/// contains one. This annotation lifts that guard for the node it is on: the JSON
/// Schema keeps the `pattern` and drops the `not: { pattern: <line breaks> }`, zod
/// drops its `noLineBreak` refinement and pydantic its `_no_line_break` validator.
///
/// The pattern itself must still mean the same in every engine on a multi-line
/// value, which is the author's to check: write it unanchored (a search for a
/// marker such as `-----BEGIN CERTIFICATE-----`), or with `[\s\S]` where it has to
/// cross lines, and never rely on `$`, `^` or `.` at a line break. Pkl's own alias
/// must not refuse a line break either (a vocabulary alias does, through `search`).
/// On an alias or a property whose type has a `@Pattern`; nothing else has a guard
/// to lift.
class MultiLine extends Annotation {}

/// A JSON Schema `format`: documentation, not validation.
class Format extends Annotation {
  /// The format's name, for example `uri`.
  name: String
}

/// A conditional requirement: when the value at `property` is one of `in`, every
/// path in `require` must be present. Written on a class, a module (a document or
/// a chart's values) or an alias of a class, and read from there by every
/// generator.
///
/// `property` and each entry of `require` are DOTTED PATHS from the annotated
/// class: `mode`, or `alerts.remote.enabled`, through blocks (a property whose
/// type is a class) and never through a list or a map. Every path is resolved
/// against the contract when it is generated, and a path that does not exist, a
/// condition that is neither a boolean nor an enum, a value of `in` the property
/// cannot hold, or a path that cannot be told apart in a schema and in Pkl (see
/// the model) is a generation error, never a rule that silently never fires.
///
/// "Present" is "not absent": a document that has not set the property. So a
/// required path must be a property without a default (nullable, or set at
/// install), and the condition's property must not default to a member of `in`:
/// a schema validator does not fill defaults in, so such a rule would mean two
/// things.
///
/// `in` holds strings for an enum and booleans for a boolean.
///
/// The condition is `in` (the value at `property` is one of them) or `contains`
/// (see below), never both.
///
/// On a class or a module `contracts.vocab.Check` makes Pkl enforce it; on an
/// alias the alias's own constraint does, as it always has (the alias writes
/// the rule once more as a lambda).
class RequiredWhen extends Annotation {
  /// The path of the property that decides.
  property: String

  /// The values of `property` that make `require` mandatory.
  `in`: Listing<String | Boolean>

  /// The condition on a LIST instead: `property` is a list of enum members (or
  /// of booleans) and the rule applies when the list holds at least one of
  /// these values. An absent list holds none. JSON Schema is
  /// `{ type: array, contains: { enum: [...] } }` under the `if`.
  contains: Listing<String | Boolean>

  /// The paths that must then be present.
  require: Listing<String>
}

/// The converse of `RequiredWhen`: every path in `require` must be present
/// UNLESS the value at `property` is one of `in`. A document that does not set
/// `property` at all (or any block on the way to it) is therefore asked for them,
/// which is what "required unless it is switched off" means. The same paths, the
/// same limits and the same enforcement as `RequiredWhen`.
class RequiredUnless extends Annotation {
  /// The path of the property that excuses.
  property: String

  /// The values of `property` that excuse `require`.
  `in`: Listing<String | Boolean>

  /// The condition on a list instead, as for `RequiredWhen`: the paths are
  /// required unless the list at `property` holds one of these values.
  contains: Listing<String | Boolean>

  /// The paths that are mandatory otherwise.
  require: Listing<String>
}

/// The converse of `RequiredWhen` for absence: when the condition holds, every
/// path in `forbid` must be ABSENT. The same paths, limits and enforcement as
/// `RequiredWhen` (a dotted path through blocks; a path with no default, because
/// a default is always there to Pkl and never there to a schema validator), and
/// the same two conditions, `in` and `contains`.
///
/// Beside a `RequiredWhen` it is the "else" of an `if`: `deny` contains `egress`
/// requires `dnsEgress` and otherwise forbids it is a `RequiredWhen` and a
/// `ForbiddenUnless` on the same condition. JSON Schema is the `if` with
/// `then: { not: { required: [...] } }`.
class ForbiddenWhen extends Annotation {
  /// The path of the property that decides.
  property: String

  /// The values of `property` that make `forbid` illegal.
  `in`: Listing<String | Boolean>

  /// The condition on a list instead: the list at `property` holds one of these.
  contains: Listing<String | Boolean>

  /// The paths that must then be absent.
  forbid: Listing<String>
}

/// Every path in `forbid` must be absent UNLESS the condition holds: a document
/// that does not set `property` at all is therefore forbidden them. See
/// `ForbiddenWhen`.
class ForbiddenUnless extends Annotation {
  /// The path of the property that excuses.
  property: String

  /// The values of `property` that excuse `forbid`.
  `in`: Listing<String | Boolean>

  /// The condition on a list instead: the list at `property` holds one of these.
  contains: Listing<String | Boolean>

  /// The paths that must be absent otherwise.
  forbid: Listing<String>
}

/// At least one of `paths` must be present: "a reason or an owner". Written on a
/// class, a module or an alias of a class, like `RequiredWhen`, with the same
/// dotted paths, the same limit (a path with no default) and the same enforcement.
/// JSON Schema is `anyOf: [{ required: [a] }, { required: [b] }]`. Two paths at
/// least; one would be `@Required`.
class RequiredAnyOf extends Annotation {
  /// The paths, one of which must be present.
  paths: Listing<String>
}

/// A comparison between a value of this object and the same kind of value in the
/// ENTRIES of one of its maps, which no path through blocks can say: for every
/// entry of the map at `each`, when the entry sets `entryProperty` to a value that
/// DIFFERS from the value of `property` here, the entry must carry every path of
/// `require`.
///
/// Both properties are an enum or both a boolean (the entry's enum may have more
/// members), neither has a default, and `each` is a dotted path through blocks to
/// a `Mapping` of a class. `property` is the REFERENCE: when this object does not
/// set it, the rule does not apply, and an entry that does not set `entryProperty`
/// is the same as the reference and needs nothing. `entryProperty` defaults to
/// `property`; `require` are paths below the entry.
///
/// JSON Schema cannot compare two values, so it is written out once for each
/// member of the reference's type: `if <property> is m` then every entry `if
/// <entryProperty> is set and is not m` `then` requires `require`. Pkl, zod and
/// pydantic compare the two values directly; the result is the same.
class RequiredWhenDiffers extends Annotation {
  /// The path of the reference value.
  property: String

  /// The path of the map whose entries are held to it.
  each: String

  /// The path, below an entry, of the value compared with the reference.
  entryProperty: String = property

  /// The paths below the entry that it must then carry.
  require: Listing<String>
}

/// Keys an open object or a map must NOT carry. On a PROPERTY whose type is a
/// `Mapping` or an open object (`Dynamic`); the property is then no longer the
/// vocabulary alias it had, and `Check.pkl` makes Pkl enforce it.
class DenyKeys extends Annotation {
  /// The keys that are refused. At least one.
  keys: Listing<String>(!isEmpty)
}

/// An open object (Pkl `Dynamic`) that must still carry certain keys.
class RequiresKeys extends Annotation {
  /// The keys the object must carry.
  keys: Listing<String>
}

/// A class that is reached by `$ref` to `#/$defs/<name>` rather than inlined.
class Def extends Annotation {
  /// The definition's name under `$defs`.
  name: String
}

/// A class that is the values of a chart: not a document of its own (it has no
/// `$id`), so it is composed with the documents it refers to.
class Chart extends Annotation {
  /// The values schema's `title`.
  title: String
}

/// A class (or a module) whose instances may carry keys it does not declare. Its
/// declared properties are typed, and the required ones required, but the object
/// is not closed: JSON Schema leaves out `additionalProperties: false` (and
/// `unevaluatedProperties`), zod is a `looseObject` and pydantic `extra="allow"`.
/// For an object a chart takes verbatim, such as the `spec` of a custom resource
/// of which the contract names only the fields it needs checked.
///
/// A key the class does not declare is any value at all, `null` included, and is
/// never read; it is a fact about DOCUMENTS. A value written in Pkl is a typed
/// object, and Pkl cannot give a typed object a property its class does not have,
/// so a Pkl-authored value sets the declared properties only (an open object
/// with no declared properties is `Dynamic`, which is open already). Only on a
/// class or a module; a property cannot be open on its own, because the class
/// has one shape wherever it is used. A class that extends an open class (one that
/// is not a document of its own) is open too.
class Open extends Annotation {}

/// A constant: the one value a boolean, a string or a number alias may be. JSON
/// Schema `const` (alone: it says the type), zod `z.literal`, pydantic
/// `Literal`. Pkl has no boolean literal type (`false | Namespace` does not
/// parse), so the vocabulary's `FalseOnly` is an alias with the constraint
/// `this == false` and this annotation, and "false or this object" is the union
/// `(V.FalseOnly | Namespace)?`: JSON Schema `anyOf: [{ const: false }, <object>]`,
/// and `true` is refused by every validator. The alias writes the constraint as
/// a lambda too (the probes run the two against each other).
///
/// On an ALIAS only; the model refuses it on a property, where it would be
/// dropped. The value is the alias's type: a boolean for `Boolean`, a whole
/// number for `Int`, any number for `Number`, a string for `String`.
class Const extends Annotation {
  /// The only value allowed.
  value: Boolean | String | Number
}
