/// Reflection into the small intermediate form every generator reads, and the
/// probes and the lint of this repository read too.
///
/// This is where `pkl:reflect`'s gaps are paid for once: it has no constrained
/// type (so constraints come from annotations on aliases and on properties), no
/// way to tell an explicit default from an implicit one (so an object-valued
/// property is told apart by comparing its default with what its class declares:
/// a default that differs is explicit; one that is the class's own is Pkl's
/// implicit default, which a document may rely on only when the class is
/// default-complete, see `defaultComplete`), and no module graph (so the modules
/// to generate for are given to the generator, which reads each one's own
/// declarations).
module contracts.model.Model

import "pkl:reflect"

/// Every character that ends a line in some regular-expression engine, as the
/// vocabulary's `lineBreaks` lists them (`test/ProbesTest.pkl` checks the two
/// are equal). A generator emits, per target, a guard that refuses a string that
/// contains any of them.
const lineBreaks: List<String> =
  List("\n", "\r", "\u{C}", "\u{B}", "\u{85}", "\u{2028}", "\u{2029}")

/// The same, as a regular-expression character class that every engine reads
/// alike: `\n`, `\r` and `\f` and the two-digit hex escapes `\x0B` and `\x85` are
/// common to all of them (`\v` is a vertical-space class in Java and a vertical
/// tab elsewhere), and no escape for U+2028 and U+2029 is, so those two are the
/// characters themselves (a JSON renderer escapes them, so a schema carries
/// `\u2028`).
const lineBreakClass: String = "[\\n\\r\\f\\x0B\\x85\u{2028}\u{2029}]"

class Node {
  /// string integer number boolean enum list map object open any union
  kind: String
  /// The vocabulary alias this type was spelled with, if any. Absent for a
  /// property whose own `@Range` or `@Length` narrowed the alias: that type is no
  /// longer the alias, and is written out in full (`aliasBase` still names it).
  alias: String?
  /// The alias a property-level annotation narrowed, for a reader's label.
  aliasBase: String?
  doc: String?
  items: Node?
  key: Node?
  members: List<Node>?
  values: List<String>?
  /// For `object`: the class.
  cls: Cls?
  schema: Dynamic?
  def: Dynamic?
  range: Dynamic?
  length: Dynamic?
  pattern: Dynamic?
  format: Dynamic?
  requiresKeys: Dynamic?
  /// The keys a map or an open object must not carry (`@DenyKeys`, on a property).
  denyKeys: List<String>?
  /// The rules across fields written on an ALIAS of a class (`@RequiredWhen`,
  /// `@RequiredUnless`), each as `condition` describes. The ones written on the
  /// class or the module itself are `Cls.conditions`.
  conditions: List<Dynamic> = List()
  chart: Dynamic?
}

/// A rule across fields, read from `@RequiredWhen` or `@RequiredUnless` and
/// resolved against the class it is written on, so that a generator can rely on
/// every path existing. A `Dynamic` with: `unless` (Boolean: `@RequiredUnless`),
/// `property` (the dotted path that decides), `path` (the same, as a list of
/// names), `values` (what the property may be: strings for an enum, booleans for
/// a boolean) and `require` (the dotted paths that must be present), `paths` (the
/// same, each as a list of names).
typealias Condition = Dynamic

class Prop {
  name: String
  type: Node
  /// A document must carry it: it has no default of any kind and is not nullable,
  /// or it is set at install.
  required: Boolean
  /// It has a default a reader may rely on: one the contract wrote, or, for an
  /// object, the one Pkl gives it when its class is default-complete.
  hasDefault: Boolean
  /// The default, as JSON-shaped data (a `Map` for an object). For an object with
  /// an implicit default, the class's own defaults, rendered whole.
  default: Any
  /// It has nothing of its own to fall back on: no default written, not
  /// nullable, not set at install. Whether that makes it required depends on its
  /// type: an object whose class is default-complete is still optional.
  bare: Boolean = false
  doc: String?
  /// The schema requires it and a chart's defaults leave it out (`@SetAtInstall`).
  /// It is nullable in Pkl, so that the module of defaults need not set it.
  setAtInstall: Boolean = false
  /// The property's value NAMES a secret (an environment variable, a Secret and
  /// key); it is never the secret itself. Read from the contract's own
  /// convention, because the vocabulary has no annotation for it: a property
  /// whose name ends in `Env` (the name of an environment variable), or whose
  /// type is a class named `Secret`.
  secret: Boolean = false
}

class Cls {
  /// Unique across the contract: module short name + class name.
  qname: String
  doc: String?
  props: List<Prop>
  /// `open` in Pkl: another document extends it, so it must not close itself.
  isOpen: Boolean = false
  /// The documented class this one extends (allOf), if any.
  base: Node?
  /// The rules across fields written on this class, or on the module it is, and
  /// on the classes it inherits that are not documents of their own (a document
  /// that is a base brings its own, through `base`).
  conditions: List<Condition> = List()
}

local const function short(n: String): String = n.split(".").last

local function qualify(mod: String, cls: String): String =
  if (mod == "Fragments" || cls.startsWith(mod)) cls else mod + cls

/// Whether annotation `a` is an instance of the vocabulary's annotation class
/// `name`. By name, not by `is`: a consumer that depends on the vocabulary as a
/// package and a generator that does the same through its own dependency see two
/// copies of one class, which `is` tells apart and this does not.
local function named(a: Annotation, name: String): Boolean =
  let (c = reflect.Class(a.getClass()))
    c.name == name && c.enclosingDeclaration.name == "contracts.vocab.Annotations"

/// The annotation of class `name` in `a`, as data, or null.
local function find(a: List<Annotation>, name: String): Dynamic? =
  a.findOrNull((x) -> named(x, name))?.toDynamic()

/// The `@Range` in `a` as data with all four ends, or null. A vocabulary of an
/// earlier release has no exclusive ends, and the generators must read it too
/// (the compatibility check generates the last release's schemas with these
/// generators): a missing end is an absent one.
local function rangeIn(a: List<Annotation>): Dynamic? =
  let (r = find(a, "Range"))
    if (r == null)
      null
    else
      new Dynamic {
        min = r.min
        max = r.max
        exclusiveMin = r.getPropertyOrNull("exclusiveMin")
        exclusiveMax = r.getPropertyOrNull("exclusiveMax")
      }

local function annots(a: List<Annotation>): Dynamic = new Dynamic {
  schema = find(a, "Schema")
  def = find(a, "Def")
  range = rangeIn(a)
  length = find(a, "Length")
  pattern = find(a, "Pattern")
  format = find(a, "Format")
  requiresKeys = find(a, "RequiresKeys")
  chart = find(a, "Chart")
}

local function withAnnots(n: Node, a: List<Annotation>, adoc: String?, aalias: String?): Node =
  let (x = annots(a))
    (n) {
      when (aalias != null) { alias = aalias }
      when (adoc != null && n.doc == null) { doc = adoc }
      when (x.schema != null) { schema = x.schema }
      when (x.def != null) { def = x.def }
      when (x.range != null) { range = normalRange(aalias ?? "a type", x.range) }
      when (x.length != null) { length = x.length }
      when (x.pattern != null) { pattern = x.pattern }
      when (x.format != null) { format = x.format }
      when (x.requiresKeys != null) { requiresKeys = x.requiresKeys }
      when (x.chart != null) { chart = x.chart }
    }

function nodeOf(t: reflect.Type): Node =
  if (t is reflect.NullableType)
    nodeOf(t.member)
  else if (t is reflect.StringLiteralType)
    new Node { kind = "enum"; values = List(t.value) }
  else if (t is reflect.UnionType)
    union(t)
  else if (t is reflect.DeclaredType)
    declared(t)
  else
    new Node { kind = "any" }

local function union(t: reflect.UnionType): Node =
  let (ms = t.members.map((m) -> nodeOf(m)))
    if (ms.every((m) -> m.kind == "enum"))
      new Node { kind = "enum"; values = ms.flatMap((m) -> m.values) }
    else
      new Node { kind = "union"; members = ms }

local function declared(t: reflect.DeclaredType): Node =
  let (r = t.referent)
    if (r is reflect.TypeAlias)
      if (nullableMember(r.referent))
        throw(nullableMemberMessage("alias `\(r.name)`"))
      else
        withAliasConditions(
          r.name,
          withAnnots(nodeOf(r.referent), r.annotations, r.docComment, r.name),
          r.annotations,
        )
    else if (r.enclosingDeclaration.uri == "pkl:base")
      base(r.name, t)
    else if (r.name == "ModuleClass")
      fromMirror(r.enclosingDeclaration as reflect.Module)
    else
      withAnnots(new Node { kind = "object"; cls = classOf(r) }, r.annotations, r.docComment, null)

local function base(name: String, t: reflect.DeclaredType): Node =
  if (name == "String")
    new Node { kind = "string" }
  else if (name == "Int")
    new Node { kind = "integer" }
  else if (name == "Float" || name == "Number")
    new Node { kind = "number" }
  else if (name == "Boolean")
    new Node { kind = "boolean" }
  else if (name == "Listing" || name == "List")
    new Node { kind = "list"; items = nodeOf(t.typeArguments[0]) }
  else if (name == "Mapping" || name == "Map")
    new Node { kind = "map"; key = nodeOf(t.typeArguments[0]); items = nodeOf(t.typeArguments[1]) }
  else if (name == "Dynamic")
    new Node { kind = "open" }
  else if (name == "Any")
    new Node { kind = "any" }
  else
    throw("Model: unsupported standard type \(name)")

local function isScalarish(n: Node): Boolean =
  !(n.kind == "object" || n.kind == "open" || n.kind == "any")

local function jsonValue(v: Any): Any =
  if (v is Listing)
    v.toList().map((e) -> jsonValue(e))
  else if (v is Mapping)
    v.toMap().mapValues((_, e) -> jsonValue(e))
  else if (v is Dynamic || v is Typed)
    // An object, as a document has it: an absent value is not a `null`.
    v
      .toMap()
      .filter((_, e) -> e != null)
      .mapValues((_, e) -> jsonValue(e))
  else
    v

local function namesSecret(n: Node): Boolean =
  (n.kind == "object" && n.cls.qname.endsWith("Secret"))
    || (n.kind == "map" && namesSecret(n.items))
    || (n.kind == "list" && namesSecret(n.items))

/// Whether a union anywhere in `t` has a nullable member. `X | Y?` is `X | (Y?)`:
/// the `?` binds to the last member only, so the field a reader takes for
/// "nullable X or Y" is nullable in Pkl and REQUIRED everywhere a generator reads
/// reflection, which is how a typo becomes a contract. `(X | Y)?` says it.
local function nullableMember(t: reflect.Type): Boolean =
  if (t is reflect.NullableType)
    nullableMember(t.member)
  else if (t is reflect.UnionType)
    t.members.any((m) -> m is reflect.NullableType || nullableMember(m))
  else if (t is reflect.DeclaredType)
    t.typeArguments.any((a) -> nullableMember(a))
  else
    false

local function nullableMemberMessage(where: String): String =
  "\(where): a union with a nullable member. `X | Y?` makes only `Y` nullable; write `(X | Y)?`"

local function bigger(a: Number?, b: Number?): Number? =
  if (a == null) b else if (b == null) a else if (a > b) a else b

local function smaller(a: Number?, b: Number?): Number? =
  if (a == null) b else if (b == null) a else if (a < b) a else b

/// A range with the redundant side of each end dropped (`min = 0` beside
/// `exclusiveMin = 0` is the exclusive one), and refused when it leaves no value:
/// the lower end above the upper, or the two meeting where either is exclusive.
local function normalRange(where: String, r: Dynamic): Dynamic =
  let (keepMin = r.min != null && !(r.exclusiveMin != null && r.exclusiveMin >= r.min))
  let (keepExMin = r.exclusiveMin != null && !(r.min != null && r.min > r.exclusiveMin))
  let (keepMax = r.max != null && !(r.exclusiveMax != null && r.exclusiveMax <= r.max))
  let (keepExMax = r.exclusiveMax != null && !(r.max != null && r.max < r.exclusiveMax))
  let (lo = if (keepMin) r.min else if (keepExMin) r.exclusiveMin else null)
  let (hi = if (keepMax) r.max else if (keepExMax) r.exclusiveMax else null)
    if (
      lo != null
        && hi != null
        && (lo > hi || (lo == hi && (keepExMin || keepExMax)))
    )
      throw("\(where): the bounds leave no value (the lower end is \(lo), the upper \(hi))")
    else
      new Dynamic {
        min = if (keepMin) r.min else null
        max = if (keepMax) r.max else null
        exclusiveMin = if (keepExMin) r.exclusiveMin else null
        exclusiveMax = if (keepExMax) r.exclusiveMax else null
      }

/// A property's own `@Range` laid over its type's: the tighter of each end, and
/// the result must leave a value.
local function narrowerRange(where: String, a: Dynamic?, b: Dynamic): Dynamic =
  if (a == null)
    normalRange(where, b)
  else
    normalRange(where, new Dynamic {
      min = bigger(a.min, b.min)
      max = smaller(a.max, b.max)
      exclusiveMin = bigger(a.exclusiveMin, b.exclusiveMin)
      exclusiveMax = smaller(a.exclusiveMax, b.exclusiveMax)
    })

/// The narrowest of two lengths: a property's own bound can only tighten what
/// its type already says, because Pkl enforces both.
local function narrower(where: String, a: Dynamic?, b: Dynamic): Dynamic =
  if (a == null)
    b
  else
    let (lo = bigger(a.min, b.min))
    let (hi = smaller(a.max, b.max))
      if (lo != null && hi != null && lo > hi)
        throw(
          "\(where): the bound of the property and the one of its type leave no value (from \(lo) to \(hi))"
        )
      else
        new Dynamic { min = lo; max = hi }

/// The type of a property, with the `@Range`, `@Length` and `@DenyKeys` the
/// property itself carries laid over the type's own. They narrow a number, a
/// string and a map or open object, and nothing else; the type is then no longer
/// the alias (zod and pydantic would refer to the alias by name and lose the
/// bound), so it is spelled out.
local function narrowed(where: String, n: Node, a: List<Annotation>): Node =
  let (r = rangeIn(a))
  let (l = find(a, "Length"))
  let (d = find(a, "DenyKeys"))
    if (r == null && l == null && d == null)
      n
    else if (r != null && n.kind != "integer" && n.kind != "number")
      throw("\(where): @Range is for a number, and this property is \(n.kind)")
    else if (l != null && n.kind != "string")
      throw("\(where): @Length is for a string, and this property is \(n.kind)")
    else if (d != null && n.kind != "map" && n.kind != "open")
      throw("\(where): @DenyKeys is for a map or an open object, and this property is \(n.kind)")
    else
      (n) {
        alias = null
        aliasBase = n.alias ?? n.aliasBase
        when (r != null) { range = narrowerRange(where, n.range, r) }
        when (l != null) { length = narrower(where, n.length, l) }
        when (d != null) { denyKeys = (n.denyKeys ?? List()) + d.keys.toList() }
      }

/// What Pkl gives a property of type `t` when nobody sets it: an instance of
/// the class with every default in place.
local function implicit(t: reflect.Type): Any =
  if (t is reflect.DeclaredType)
    let (r = t.referent)
      if (r is reflect.TypeAlias)
        implicit(r.referent)
      else if (r.enclosingDeclaration.uri == "pkl:base")
        if (r.name == "Dynamic") new Dynamic {} else null
      else if (r.name == "ModuleClass")
        null
      else
        new Dynamic {}.toTyped((r as reflect.Class).reflectee)
  else
    null

/// Whether an object-valued property was given a default of its own. Reflection
/// cannot tell, but it can compare: the property's default against what its
/// class declares for itself. A default that is exactly the class's own is none
/// (the fields carry their defaults), which is why such a property is required.
local function explicitObject(p: reflect.Property, n: Node): Boolean =
  !isModuleType(p.type)
    && readable(n)
    && p.defaultValue != null
    && p.defaultValue.toString() != implicit(p.type).toString()

/// Whether the default of a property of type `n` can be read. Pkl checks a
/// constraint when a value is read, and reflection has no way to catch the error,
/// so an open object that must carry keys (`V.Named`), whose implicit default
/// `{}` breaks its own constraint, cannot be asked for its default: it is an
/// error, not a null. Such a property is read as having none, so it is required.
local function readable(n: Node): Boolean = n.requiresKeys == null

/// The default of `p` (of type `n`), or null when it has none that can be read.
local function defaultOf(p: reflect.Property, n: Node): Any =
  if (readable(n)) p.defaultValue else null

/// A property whose type is a module (`config: ServiceConfig`): its default is
/// the module's own, not a default the property was given.
local function isModuleType(t: reflect.Type): Boolean =
  if (t is reflect.NullableType)
    isModuleType(t.member)
  else if (t is reflect.DeclaredType)
    let (r = t.referent)
      if (r is reflect.TypeAlias) isModuleType(r.referent) else r.name == "ModuleClass"
  else
    false

/// The properties of `c` and of the classes it extends, the base first.
local function allProps(c: Cls): List<Prop> =
  (if (c.base != null) allProps(c.base.cls) else List()) + c.props

/// Whether Pkl's own default for a value of type `n` (an instance built from the
/// class's defaults, or an empty object) is a value the contract accepts, so that
/// a document may leave the property out. A class is default-complete when every
/// property has a default, is nullable, or is itself of a default-complete class
/// type (recursively). A property that is set at install, or has no default and is
/// not nullable, makes the class not complete; so does an open object that must
/// carry keys. `seen` guards a cycle: a class met again on the way down is not
/// complete (its own default would never end).
local function defaultComplete(n: Node, seen: List<String>): Boolean =
  if (n.kind == "open")
    n.requiresKeys == null
  else if (n.kind == "object" && !seen.contains(n.cls.qname))
    allProps(n.cls)
      .every((p) ->
        !p.setAtInstall
          && (
            !p.bare
              || (
                (p.type.kind == "object" || p.type.kind == "open")
                  && defaultComplete(p.type, seen + List(n.cls.qname))
              )
          )
      )
  else
    false

/// The default of an object a property was not given one for, as the data Pkl
/// gives: every default of its class (and of the classes it extends), the nested
/// objects' included. A nullable property is absent.
local function implicitDefault(n: Node): Any =
  if (n.kind == "open")
    Map()
  else
    allProps(n.cls)
      .filter((p) -> p.hasDefault)
      .toMap((p) -> p.name, (p) -> p.default)

local function propOf(where: String, pname: String, p: reflect.Property): Prop =
  let (here = "\(where).\(pname)")
  let (n = narrowed(here, nodeOf(p.type), p.annotations))
  let (nullable = p.type is reflect.NullableType)
  let (atInstall = find(p.annotations, "SetAtInstall") != null)
  let (explicit = !isScalarish(n) && explicitObject(p, n))
  let (own = if (isScalarish(n)) defaultOf(p, n) != null else explicit)
  let (isBare = !atInstall && !nullable && !own)
  let (implicitObject = isBare && defaultComplete(n, List()))
    if (nullableMember(p.type))
      throw(nullableMemberMessage(here))
    else if (atInstall && !nullable)
      throw(
        "\(here): @SetAtInstall needs a nullable type (`V.NonEmptyString?`), so that the module of defaults can leave it out"
      )
    else if (atInstall && defaultOf(p, n) != null)
      throw("\(here): @SetAtInstall and a default contradict: the default is what it leaves out")
    else if (atInstall && n.kind == "string" && (n.length?.min ?? 0) < 1)
      throw(
        "\(here): @SetAtInstall on a string needs a non-empty type (`V.NonEmptyString`): the schema must require a real value"
      )
    else
      new Prop {
        name = pname
        type = n
        doc = p.docComment
        setAtInstall = atInstall
        secret = pname.endsWith("Env") || namesSecret(n)
        bare = isBare
        required = atInstall || (isBare && !implicitObject)
        hasDefault = own || implicitObject
        default =
          if (own)
            jsonValue(p.defaultValue)
          else if (implicitObject)
            implicitDefault(n)
          else
            null
      }

local function propsOf(where: String, props: Map<String, reflect.Property>): List<Prop> =
  props
    .toMap()
    .filter((_, p) -> !p.modifiers.contains("hidden") && !p.modifiers.contains("local"))
    .toMap()
    .entries
    .map((e) -> propOf(where, e.first, e.second))

/// The properties `c` inherits from classes that are not documents of their own,
/// the base's first. A base that is a document (`@Schema`) is not folded in: it
/// is the `base` of the class, composed by `allOf`; any other base has no schema
/// to refer to, so what it declares is the class's own.
local function inherited(c: reflect.Class): Map<String, reflect.Property> =
  let (sup = c.superclass)
    if (
      sup == null
        || sup.enclosingDeclaration.uri == "pkl:base"
        || annots(sup.annotations).schema != null
    )
      Map()
    else
      inherited(sup) + sup.properties.toMap()

/// The properties along the dotted path `full` from class `c`, one for each
/// name, resolved in `c` and in the classes it extends. A name that is no
/// property, or a path that goes through anything but a block (a property whose
/// type is a class), is a generation error: a rule that names nothing would
/// never fire, and a generator that skipped it would hide that.
local function hops(where: String, c: Cls, segments: List<String>, full: String): List<Prop> =
  let (p = allProps(c).findOrNull((x) -> x.name == segments.first))
    if (p == null)
      throw(
        "\(where): `\(full)` names no property: `\(c.qname)` has no `\(segments.first)` (it has \(allProps(c).map((x) -> "`\(x.name)`").join(", "))"
          + ")"
      )
    else if (segments.length == 1)
      List(p)
    else if (p.type.kind != "object")
      throw(
        "\(where): `\(full)` goes through `\(segments.first)`, which is \(typeLabel(p.type)) and not a block: a path runs through blocks only"
      )
    else
      List(p) + hops(where, p.type.cls, segments.drop(1), full)

/// A block on the way to a path may not have a default of its own: Pkl would see
/// what that default holds, and a schema validator, which does not fill a default
/// in, would see nothing.
local function checkWay(where: String, ps: List<Prop>, full: String): Boolean =
  ps
    .dropLast(1)
    .every((p) ->
      (!p.hasDefault || p.bare)
        || throw(
          "\(where): `\(full)` goes through `\(p.name)`, which has a default of its own: Pkl would find in it what a schema validator, which fills no default in, does not"
        )
    )

/// One rule across fields, resolved against `c`, or an error saying what is
/// wrong with it.
local function condition(where: String, c: Cls, a: Dynamic, isUnless: Boolean): Condition =
  let (kind = if (isUnless) "@RequiredUnless" else "@RequiredWhen")
  let (here = "\(where) \(kind)")
  let (vals = a.`in`.toList())
  let (segments = a.property.split("."))
  let (way = hops(here, c, segments, a.property))
  let (leaf = way.last)
  let (
    resolved =
      a.require
        .toList()
        .map((r) ->
          let (rs = r.split("."))
          let (rway = hops(here, c, rs, r))
            if (!checkWay(here, rway, r))
              throw("unreachable")
            else if (rway.last.hasDefault)
              throw(
                "\(here): `\(r)` has a default, so it is always present to Pkl and never required of a document; a required path is a property with none (nullable, or set at install)"
              )
            else
              rs
        )
  )
    if (a.require.toList().isEmpty)
      throw("\(here): `require` names nothing")
    else if (vals.isEmpty)
      throw("\(here): `in` names no value")
    else if (!checkWay(here, way, a.property) || resolved.length < 0)
      throw("unreachable")
    else if (leaf.type.kind != "boolean" && leaf.type.kind != "enum")
      throw(
        "\(here): `\(a.property)` is \(typeLabel(leaf.type)); a condition is on a boolean or an enum"
      )
    else if (leaf.type.kind == "boolean" && !vals.every((v) -> v is Boolean))
      throw("\(here): `\(a.property)` is a boolean, so `in` lists booleans")
    else if (
      leaf.type.kind == "enum"
        && !vals.every((v) -> v is String && leaf.type.values.contains(v))
    )
      throw(
        "\(here): `in` has a value `\(a.property)` cannot hold (it is one of \(leaf.type.values.map((v) -> "`\(v)`").join(", ")))"
      )
    else if (leaf.hasDefault && vals.contains(leaf.default))
      throw(
        "\(here): `\(a.property)` defaults to \(literal(leaf.default)), a value of `in`: a document that leaves it out means one thing to Pkl and another to a schema validator, which fills no default in"
      )
    else
      new Dynamic {
        unless = isUnless
        property = a.property
        path = segments
        `values` = vals
        require = a.require.toList()
        paths = resolved
      }

/// The conditions written in annotations `a`, resolved against `c`.
local function conditionsOf(where: String, c: Cls, a: List<Annotation>): List<Condition> =
  a
    .filter((x) -> named(x, "RequiredWhen"))
    .map((x) -> condition(where, c, x.toDynamic(), false))
    + a
      .filter((x) -> named(x, "RequiredUnless"))
      .map((x) -> condition(where, c, x.toDynamic(), true))

/// The annotations of class `c` and of the classes it inherits that are not
/// documents of their own (what `inherited` folds into it).
local function conditionAnnotations(c: reflect.Class): List<Annotation> =
  c.annotations
    + (
      let (sup = c.superclass)
        if (
          sup == null
            || sup.enclosingDeclaration.uri == "pkl:base"
            || annots(sup.annotations).schema != null
        )
          List()
        else
          conditionAnnotations(sup)
    )

/// `n`, an alias's node, with the rules the alias carries. Only an alias of a
/// class can carry one.
local function withAliasConditions(name: String, n: Node, a: List<Annotation>): Node =
  let (annotated = a.any((x) -> named(x, "RequiredWhen") || named(x, "RequiredUnless")))
    if (!annotated)
      n
    else if (n.kind != "object")
      throw("\(name): a rule across fields is for an alias of a class, and this is \(n.kind)")
    else
      (n) { conditions = conditionsOf(name, n.cls, a) }

local function classOf(c: reflect.Class): Cls =
  let (mod = c.enclosingDeclaration)
  let (sup = c.superclass)
  let (
    k = new Cls {
      qname = qualify(short(mod.name), c.name)
      doc = c.docComment
      props = propsOf(c.name, inherited(c) + c.properties.toMap())
      when (
        sup != null
          && sup.enclosingDeclaration.uri != "pkl:base"
          && annots(sup.annotations).schema != null
      ) {
        base = declared(reflect.DeclaredType(sup))
      }
    }
  )
    (k) { conditions = conditionsOf(k.qname, k, conditionAnnotations(c)) }

/// The root node of a module that is itself a document.
function moduleNode(m: Module): Node = fromMirror(reflect.Module(m))

local function fromMirror(mm: reflect.Module): Node =
  let (sup = mm.supermodule)
  let (hasBase = sup != null && sup.annotations.any((a) -> named(a, "Schema")))
  let (
    k = new Cls {
      qname = short(mm.name)
      doc = mm.docComment
      // A document that extends another is its own properties and an `allOf`; a
      // chart is everything it inherits, because it has no base to compose.
      props =
        propsOf(
          short(mm.name),
          if (hasBase) mm.moduleClass.properties else mm.moduleClass.allProperties,
        )
      isOpen = mm.modifiers.contains("open")
      when (hasBase) { base = fromMirror(sup) }
    }
  )
    withAnnots(
      new Node {
        kind = "object"
        cls = (k) { conditions = conditionsOf(short(mm.name), k, mm.annotations) }
      },
      mm.annotations,
      mm.docComment,
      null,
    )

/// The root node of a class or alias in `m` that is a document.
function declNode(m: Module, name: String): Node =
  let (mm = reflect.Module(m))
    if (mm.typeAliases.containsKey(name))
      declared(reflect.DeclaredType(mm.typeAliases[name]))
    else
      declared(reflect.DeclaredType(mm.classes[name]))

/// The names in `m` that are documents: annotated with `@Schema`.
function documentNames(m: Module): List<String> =
  let (mm = reflect.Module(m))
    mm.classes.toMap().filter((_, c) -> c.annotations.any((a) -> named(a, "Schema"))).keys.toList()
      + mm.typeAliases
        .toMap()
        .filter((_, c) -> c.annotations.any((a) -> named(a, "Schema")))
        .keys
        .toList()

local function kids(n: Node): List<Node> =
  if (n.kind == "object")
    n.cls.props.map((p) -> p.type) + (if (n.cls.base != null) List(n.cls.base) else List())
  else if (n.kind == "list")
    List(n.items)
  else if (n.kind == "map")
    List(n.key, n.items)
  else if (n.kind == "union")
    n.members
  else
    List()

/// Every node in the subtree of `n`, `n` first.
function walk(n: Node): List<Node> = List(n) + kids(n).flatMap((c) -> walk(c))

/// `n` and the classes it extends, the base first: a generated class can only
/// extend one that is declared above it.
local function withBases(n: Node): List<Node> =
  (if (n.cls.base != null) withBases(n.cls.base) else List()) + List(n)

/// The distinct classes and aliases reachable from `roots`, in first-seen order,
/// each after the classes it extends.
function classes(roots: List<Node>): List<Node> =
  roots
    .flatMap((r) -> walk(r))
    .filter((n) -> n.kind == "object")
    .flatMap((n) -> withBases(n))
    .distinctBy((n) -> n.cls.qname)

/// The same, but without descending into other documents (they are `$ref`s).
function walkOwn(n: Node): List<Node> =
  List(n) + kids(n).flatMap((c) -> if (c.schema != null) List(c) else walkOwn(c))

/// The aliases reachable from `roots` that name a plain type.
function aliases(roots: List<Node>): List<Node> =
  roots
    .flatMap((r) -> walk(r))
    .filter((n) -> n.alias != null && n.kind != "object")
    .distinctBy((n) -> n.alias)

/// The aliases reachable from `roots` that name a class: a class and a rule
/// across its fields.
function classAliases(roots: List<Node>): List<Node> =
  roots
    .flatMap((r) -> walk(r))
    .filter((n) -> n.alias != null && n.kind == "object")
    .distinctBy((n) -> n.alias)

/// The key a document is known by: the tail of its `$id` after `/schemas/`, or
/// its last path element, without `.json`.
function key(n: Node): String =
  let (id = n.schema.id)
    (if (id.contains("/schemas/")) id.split("/schemas/").last else id.split("/").last).replaceAll(
      ".json",
      "",
    )

/// What of module `m` a generator starts from: `m` itself if it is a document,
/// the chart it is or amends, and each class or alias in it that is a document.
function rootsOf(m: Module): List<Node> =
  let (mm = reflect.Module(m))
  let (chart = chartOf(m))
    (if (mm.annotations.any((a) -> named(a, "Schema"))) List(moduleNode(m)) else List())
      + (if (chart != null) List(chart) else List())
      + documentNames(m).map((d) -> declNode(m, d))

/// The documents of `modules`, by key: those they declare and those these refer
/// to by `$ref` (a fragment, a base), because a schema that refers to a document
/// is only usable beside it.
function documents(modules: List<Module>): Mapping<String, Node> =
  let (
    all =
      modules
        .flatMap((m) -> rootsOf(m))
        .flatMap((r) -> walk(r))
        .filter((n) -> n.schema != null)
        .distinctBy((n) -> n.schema.id)
        .sortBy((n) -> key(n))
  )
  let (shared = inlineEnumProblems(classes(all + modules.map((m) -> chartOf(m)).filterNonNull())))
    if (shared.isEmpty)
      new Mapping {
        for (n in all) {
          [key(n)] = n
        }
      }
    else
      throw("an inline union of literals is used in more than one place:\n  " + shared.join("\n  "))

/// The inline unions of string literals (`"a" | "b"`, two members or more) in the
/// properties of one class, with where each is. A type that is an alias (a
/// vocabulary enum) is not inline, and a property that holds a list or a map of
/// them counts too.
local function inlineEnums(c: Cls): List<Pair<String, List<String>>> =
  c.props.flatMap((p) -> inlineIn(p.type).map((vs) -> Pair("\(c.qname).\(p.name)", vs)))

local function inlineIn(n: Node): List<List<String>> =
  if (n.alias != null)
    List()
  else if (n.kind == "enum" && n.values.length >= 2)
    List(n.values)
  else if (n.kind == "list")
    inlineIn(n.items)
  else if (n.kind == "map")
    inlineIn(n.key) + inlineIn(n.items)
  else if (n.kind == "union")
    n.members.flatMap((m) -> inlineIn(m))
  else
    List()

/// The inline literal unions that two properties of `nodes` (classes) share, or
/// overlap on: such a union is one concept written twice, and belongs in the
/// vocabulary as an enum, where it is one name for every contract. A union used
/// in ONE place is fine inline. Each problem is a sentence.
function inlineEnumProblems(nodes: List<Node>): List<String> =
  let (
    all =
      nodes
        .filter((n) -> n.kind == "object")
        .flatMap((n) -> inlineEnums(n.cls))
  )
    all
      .mapIndexed((i, a) ->
        all
          .drop(i + 1)
          .filter((b) -> a.second.any((v) -> b.second.contains(v)))
          .map((b) ->
            "`\(a.first)` (\(a.second.map((v) -> literal(v)).join(" | "))) and `\(b.first)` (\(b.second.map((v) -> literal(v)).join(" | "))) overlap: one concept in two places, so make it an enum in the vocabulary"
          )
      )
      .flatten()

/// The chart module `m` is, or amends: the module annotated `@Chart`, or null.
function chartOf(m: Module): Node? =
  let (mm = reflect.Module(m))
    chartIn(mm)

local function chartIn(mm: reflect.Module?): Node? =
  if (mm == null)
    null
  else if (mm.annotations.any((a) -> named(a, "Chart")))
    fromMirror(mm)
  else
    chartIn(mm.supermodule)

/// Whether `m` is itself the chart module (a contract), rather than a module
/// that amends one (values).
function isChartModule(m: Module): Boolean =
  reflect.Module(m).annotations.any((a) -> named(a, "Chart"))

/// A value written as it would be in a document: a string quoted, a list in
/// brackets.
function literal(v: Any): String =
  if (v is String)
    // Escaped, so that a default with a line break or a quote stays on one line
    // of a Markdown table and says where it ends.
    "\"\(v.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"").replaceAll("\n", "\\n").replaceAll("\r", "\\r").replaceAll("\t", "\\t"))\""
  else if (v is List)
    "[\(v.map((e) -> literal(e)).join(", "))]"
  else if (v is Map)
    "{\(v.entries.map((e) -> "\(literal(e.first)): \(literal(e.second))").join(", "))}"
  else
    "\(v)"

/// What a reader calls the type of `n`: the vocabulary's name for it when it
/// has one, otherwise its shape.
function typeLabel(n: Node): String =
  if (n.alias != null)
    n.alias
  else if (n.aliasBase != null)
    n.aliasBase
  else if (n.kind == "object")
    n.cls.qname
  else if (n.kind == "enum")
    n.values.map((v) -> literal(v)).join(" | ")
  else if (n.kind == "list")
    "list of \(typeLabel(n.items))"
  else if (n.kind == "map")
    "map of \(typeLabel(n.items))"
  else if (n.kind == "open")
    "object"
  else if (n.kind == "union")
    n.members.map((m) -> typeLabel(m)).join(" | ")
  else
    n.kind

/// A number written in a phrase: whole when it is.
local function num(x: Number): String = "\(x)"

/// The range `r` in words.
local function rangePhrase(r: Dynamic): String =
  if (r.min != null && r.max != null)
    "from \(num(r.min)) to \(num(r.max))"
  else
    List(
      if (r.min != null) "at least \(num(r.min))" else null,
      if (r.exclusiveMin != null) "greater than \(num(r.exclusiveMin))" else null,
      if (r.max != null) "at most \(num(r.max))" else null,
      if (r.exclusiveMax != null) "less than \(num(r.exclusiveMax))" else null,
    )
      .filterNonNull()
      .join(" and ")

/// A rule across fields in words.
function conditionPhrase(d: Condition): String =
  let (vs = d.values.map((v) -> "`\(v)`").join(" or "))
  let (need = d.require.map((k) -> "`\(k)`").join(", "))
    if (d.unless)
      "unless `\(d.property)` is \(vs), \(need) are required"
    else
      "when `\(d.property)` is \(vs), \(need) are required"

/// The constraints `n` carries, one phrase each, for documentation.
function constraintsOf(n: Node): List<String> =
  (if (n.range == null) List() else List(rangePhrase(n.range)))
    + (
      if (n.length == null)
        List()
      else
        List(
          if (n.length.min != null && n.length.max != null)
            "length \(n.length.min) to \(n.length.max)"
          else if (n.length.min != null)
            "at least \(n.length.min) character\(if (n.length.min == 1) "" else "s")"
          else
            "at most \(n.length.max) characters",
        )
    )
    + (if (n.pattern == null) List() else List("matches `\(n.pattern.regex)`, never a line break"))
    + (if (n.format == null) List() else List("format `\(n.format.name)`"))
    + (
      if (n.requiresKeys == null)
        List()
      else
        List("has the keys \(n.requiresKeys.keys.toList().map((k) -> "`\(k)`").join(", "))")
    )
    + (
      if (n.denyKeys == null)
        List()
      else
        List("never has the keys \(n.denyKeys.map((k) -> "`\(k)`").join(", "))")
    )
    + n.conditions.map((d) -> conditionPhrase(d))
