/// Python models (pydantic v2) from the intermediate form.
///
/// Choices, each one a rule of decision 0010:
///
///   - a model refuses an undeclared key (`extra="forbid"`) and is strict, so a
///     string is never a number;
///   - an optional property is absent, never `null`: pydantic would accept
///     `None` for an `X | None` field, so a model validator that runs before
///     the rest refuses an explicit `null`, and an optional field is `= None`
///     only to say "absent";
///   - a field with a default is optional (`Field(default=...)`);
///   - an integral float is an integer: strict mode refuses `20.0` for an
///     `int`, so an integer is read through a validator that accepts a float
///     with no fractional part, and nothing else;
///   - a pattern is a search that never admits a line break: pydantic's own
///     regular expressions are a search, and `$` matches only at the very end,
///     but a pattern with no `$` would admit a newline, and other engines stop
///     at other line breaks, so every pattern is paired with a validator that
///     refuses any of them (LF, CR, FF, VT, NEL, LS, PS);
///   - a default is any JSON value: an object default of an open object is a
///     plain `dict`, and one of a class is built through that class, so that it
///     is the model and not a dictionary;
///   - a property whose name is not a usable attribute (`service-lib`, a Python
///     keyword such as `global`, a leading underscore or digit) is declared
///     under a safe name with
///     `Field(alias="<name>")`, so the document's key is still the contract's.
module contracts.python.Pydantic

import "@model/Model.pkl"

/// One character of a string written inside double quotes in source: a quote, a
/// backslash and every control character or line separator (a raw line feed ends
/// a TypeScript or Python string) as an escape both languages read alike.
local function escapeChar(c: String): String =
  if (c == "\\")
    "\\\\"
  else if (c == "\"")
    "\\\""
  else if (c == "\n")
    "\\n"
  else if (c == "\r")
    "\\r"
  else if (c == "\t")
    "\\t"
  else
    let (cp = c.codePoints.first)
      if (cp < 32 || (cp >= 127 && cp <= 159) || cp == 8232 || cp == 8233)
        "\\u" + cp.toRadixString(16).padStart(4, "0")
      else
        c

/// A string as a double-quoted literal.
local function quote(v: String): String = "\"" + v.chars.map((c) -> escapeChar(c)).join("") + "\""

local function lit(v: Any): String =
  if (v is String)
    quote(v)
  else if (v == null)
    "None"
  else if (v is Boolean)
    (if (v) "True" else "False")
  else if (v is List)
    "[\(v.map((e) -> lit(e)).join(", "))]"
  else if (v is Map)
    "{\(v.entries.map((e) -> "\(lit(e.first)): \(lit(e.second))").join(", "))}"
  else
    "\(v)"

/// Words Python reserves: an attribute cannot be one.
local keywords: Set<String> =
  Set(
    "False",
    "None",
    "True",
    "and",
    "as",
    "assert",
    "async",
    "await",
    "break",
    "class",
    "continue",
    "def",
    "del",
    "elif",
    "else",
    "except",
    "finally",
    "for",
    "from",
    "global",
    "if",
    "import",
    "in",
    "is",
    "lambda",
    "nonlocal",
    "not",
    "or",
    "pass",
    "raise",
    "return",
    "try",
    "while",
    "with",
    "yield",
  )

/// The name a property is declared under: its own when that is a usable
/// attribute. A Python keyword gains a trailing underscore; anything else that is
/// not a plain identifier, or that starts with an underscore (pydantic reads one
/// as private and drops the field), is rewritten to one. Only a name that
/// could not be an attribute at all, or would not be a field, is touched: a name
/// that merely shadows something of `BaseModel`'s works and stays as it is.
local function pyName(name: String): String =
  if (name.matches(Regex("[A-Za-z][A-Za-z0-9_]*")))
    if (keywords.contains(name)) "\(name)_" else name
  else
    let (safe = name.replaceAll(Regex("[^A-Za-z0-9_]"), "_"))
      if (safe.matches(Regex("[A-Za-z].*")))
        if (keywords.contains(safe)) "\(safe)_" else safe
      else
        "f" + (if (safe.startsWith("_")) safe else "_" + safe)

local function rawStr(r: String): String = "r\"\(r.replaceAll("\"", "\\\""))\""

/// A documentation comment as the body of a triple-quoted docstring: a backslash
/// is doubled, a run of three quotes cannot be in it, and a quote at the very end
/// would close the string one quote early.
local function docstring(d: String): String =
  let (e = d.replaceAll("\\", "\\\\").replaceAll("\"\"\"", "'''"))
    if (e.endsWith("\"")) e.dropLast(1) + "\\\"" else e

local function comment(d: String?, indent: String): String =
  if (d == null) "" else d.split("\n").map((l) -> "\(indent)#: \(l)\n").join("")

/// The annotation for a node, referring to aliases and classes by name (a name
/// declared further down is fine: the module defers its annotations).
local function ann(n: Model.Node): String =
  if (n.kind == "object")
    n.alias ?? n.cls.qname
  else if (n.alias != null)
    n.alias
  else
    inner(n)

local function constraints(parts: List<String?>): String = parts.filterNonNull().join(", ")

local function inner(n: Model.Node): String =
  if (n.kind == "string")
    if (n.length == null && n.pattern == null)
      "str"
    else
      "Annotated[str, StringConstraints(\(constraints(
        List(
          if (n.length?.min != null) "min_length=\(n.length.min)" else null,
          if (n.length?.max != null) "max_length=\(n.length.max)" else null,
          if (n.pattern != null) "pattern=\(rawStr(n.pattern.regex))" else null,
        ),
      ))\(if (n.pattern != null) "), AfterValidator(_no_line_break)]" else ")]")"
  else if (n.kind == "integer")
    "Annotated[int, BeforeValidator(_integral)\(range(n))]"
  else if (n.kind == "number")
    if (n.range == null) "float" else "Annotated[float\(range(n))]"
  else if (n.kind == "boolean")
    "bool"
  else if (n.kind == "enum")
    "Literal[\(n.values.map((v) -> lit(v)).join(", "))]"
  else if (n.kind == "list")
    "list[\(ann(n.items))]"
  else if (n.kind == "map")
    "dict[\(ann(n.key)), \(ann(n.items))]"
  else if (n.kind == "open")
    if (n.requiresKeys == null)
      "dict[str, Any]"
    else
      "Annotated[dict[str, Any], AfterValidator(_has_keys(\(lit(n.requiresKeys.keys.toList()))))]"
  else if (n.kind == "union")
    n.members.map((m) -> ann(m)).join(" | ")
  else
    "Any"

local function range(n: Model.Node): String =
  if (n.range == null)
    ""
  else
    ", Field(\(constraints(
      List(
        if (n.range.min != null) "ge=\(n.range.min)" else null,
        if (n.range.max != null) "le=\(n.range.max)" else null,
      ),
    )))"

/// `Field(...)` of a property: its default (or `None`, for an absent optional)
/// and the alias its document key needs, or nothing when it needs neither.
local function fieldCall(p: Model.Prop): String =
  let (alias = if (pyName(p.name) == p.name) null else "alias=\(lit(p.name))")
  let (
    dflt =
      if (p.hasDefault && p.type.kind == "object")
        "default_factory=lambda: \(p.type.alias ?? p.type.cls.qname).model_validate(\(lit(p.default)))"
      else if (p.hasDefault)
        "default=\(lit(p.default))"
      else if (!p.required)
        "default=None"
      else
        null
  )
    if (alias == null)
      if (dflt == null) "" else if (dflt == "default=None") " = None" else " = Field(\(dflt))"
    else
      " = Field(\(constraints(List(dflt, alias))))"

local function field(p: Model.Prop): String =
  comment(p.doc, "    ")
    + "    \(pyName(p.name)): \(ann(p.type))\(if (!p.required && !p.hasDefault) " | None" else "")"
    + fieldCall(p)
    + "\n"

/// Two properties of one class that would be declared under one name.
local function collisions(c: Model.Cls): List<String> =
  c.props
    .map((p) -> pyName(p.name))
    .distinct
    .filter((n) -> c.props.count((p) -> pyName(p.name) == n) > 1)
    .map((n) ->
      "\(c.qname): \(c.props.filter((p) -> pyName(p.name) == n).map((p) -> "`\(p.name)`").join(" and ")) are all `\(n)` in Python"
    )

local function classDef(c: Model.Cls): String =
  if (!collisions(c).isEmpty)
    throw(collisions(c).join("\n"))
  else
    classBody(c)

local function classBody(c: Model.Cls): String =
  "class \(c.qname)(\(if (c.base != null) c.base.cls.qname else "_Closed")):\n"
    + (
      if (c.doc != null)
        "    \"\"\"\(docstring(c.doc))\"\"\"\n"
      else
        ""
    )
    + (
      if (c.isOpen)
        "    model_config = ConfigDict(extra=\"allow\")\n"
      else if (c.base != null)
        "    model_config = ConfigDict(extra=\"forbid\")\n"
      else
        ""
    )
    + (if (c.props.isEmpty) "    pass\n" else c.props.map((p) -> field(p)).join(""))
    + "\n\n"

local function classAliasDef(n: Model.Node): String =
  "class \(n.alias)(\(n.cls.qname)):\n"
    + (
      if (n.requiredWhen == null)
        "    pass\n"
      else
        "    @model_validator(mode=\"after\")\n"
          + "    def _conditional(self) -> \"\(n.alias)\":\n"
          + "        if self.\(pyName(n.requiredWhen.property)) in \(lit(n.requiredWhen.`in`.toList())):\n"
          + "            missing = [k for k in \(lit(n.requiredWhen.require.toList().map((k) -> pyName(k)))) if getattr(self, k) is None]\n"
          + "            if missing:\n"
          + "                raise ValueError(f\"{missing} required when \(n.requiredWhen.property) is \(n.requiredWhen.`in`.join(" or "))\")\n"
          + "        return self\n"
    )
    + "\n\n"

local header: String =
  #"""
  # Generated from a contract by contracts.python. Do not edit.
  from __future__ import annotations

  from typing import Annotated, Any, Literal

  from pydantic import (
      AfterValidator,
      BaseModel,
      BeforeValidator,
      ConfigDict,
      Field,
      StringConstraints,
      model_validator,
  )


  def _no_line_break(value: str) -> str:
      # Every character that ends a line in some engine: LF, CR, FF, VT, NEL, LS, PS.
      if any(c in value for c in "\n\r\f\v\x85\u2028\u2029"):
          raise ValueError("a line break is not allowed")
      return value


  def _integral(value: Any) -> Any:
      # An integral float is an integer (20.0 is 20); a bool, a string or a
      # float with a fractional part is not.
      if isinstance(value, float) and value.is_integer():
          return int(value)
      return value


  def _has_keys(keys: list[str]):
      def check(value: dict[str, Any]) -> dict[str, Any]:
          missing = [k for k in keys if k not in value]
          if missing:
              raise ValueError(f"missing {missing}")
          return value

      return check


  class _Closed(BaseModel):
      model_config = ConfigDict(extra="forbid", strict=True)

      @model_validator(mode="before")
      @classmethod
      def _optional_is_absent_not_null(cls, data: Any) -> Any:
          if isinstance(data, dict):
              for key, value in data.items():
                  if value is None:
                      raise ValueError(f"{key}: null is not a value; omit the key")
          return data


  """#

/// The Python module for the documents in `roots`.
function render(roots: Mapping<String, Model.Node>): String =
  let (ns = roots.toMap().values.toList())
    header
      + Model.aliases(ns).map((a) -> "\(a.alias) = \(inner(a))\n").join("")
      + "\n\n"
      + Model.classes(ns).map((c) -> classDef(c.cls)).join("")
      + Model.classAliases(ns).map((a) -> classAliasDef(a)).join("")
      + "SCHEMAS: dict[str, type[BaseModel]] = {\n"
      + roots
        .toMap()
        .entries
        .map((e) -> "    \(lit(e.first)): \(e.second.alias ?? e.second.cls.qname),\n")
        .join("")
      + "}\n"
