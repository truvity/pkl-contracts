/// Python models (pydantic v2) from the intermediate form.
///
/// Choices, each one a rule of decision 0010:
///
///   - a model refuses an undeclared key (`extra="forbid"`) and is strict, so a
///     string is never a number;
///   - an optional property is absent, never `null`: pydantic would accept
///     `None` for an `X | None` field, so a model validator that runs before
///     the rest refuses an explicit `null`, and an optional field is `= None`
///     only to say "absent";
///   - a field with a default is optional (`Field(default=...)`);
///   - an integral float is an integer: strict mode refuses `20.0` for an
///     `int`, so an integer is read through a validator that accepts a float
///     with no fractional part, and nothing else;
///   - a pattern is a search that never admits a line break: pydantic's own
///     regular expressions are a search, and `$` matches only at the very end,
///     but a pattern with no `$` would admit a newline, and other engines stop
///     at other line breaks, so every pattern is paired with a validator that
///     refuses any of them (LF, CR, FF, VT, NEL, LS, PS);
///   - a default is any JSON value: an object default of an open object is a
///     plain `dict`, and one of a class is built through that class, so that it
///     is the model and not a dictionary;
///   - a rule across fields (`@RequiredWhen`, `@RequiredUnless`) is a
///     `model_validator(mode="after")` that reads each dotted path through `_at`
///     (absent on the way is absent); one per class, named for the class so that
///     a subclass adds to its base's instead of replacing it;
///   - `@DenyKeys` is an `AfterValidator` that refuses a key on the list;
///   - an exclusive bound is `Field(gt=...)` or `Field(lt=...)`;
///   - `@Items` is `Field(min_length=..., max_length=...)` on the list, and
///     `uniqueItems` an `AfterValidator` (`_distinct`) that compares the items as
///     JSON with the keys sorted, as JSON Schema does; `@Properties` is the same
///     `Field(min_length=..., max_length=...)` on the `dict`;
///   - `@NotPattern` is an `AfterValidator` (`_not_pattern`) that refuses a
///     match of the rule's expression, with its reason as the message. It is
///     Python's `re`, where `pattern` is pydantic's own engine: the vocabulary
///     writes its expressions in the subset the two share;
///   - a union is `X | Y`, which, like JSON Schema's `anyOf`, accepts a value that
///     is any member (see `JsonSchema`);
///   - `@Nullable` is `| None` on the field, and the key is listed in the class's
///     `_nullable`, which the model validator above reads so that it does not
///     refuse that key's `null`; `@MultiLine` leaves out `_no_line_break` of its
///     node; `@OneOfValues` is an `AfterValidator` (`_one_of`) that tests membership;
///   - a property whose name is not a usable attribute (`service-lib`, a Python
///     keyword such as `global`, a leading underscore or digit) is declared
///     under a safe name with
///     `Field(alias="<name>")`, so the document's key is still the contract's.
module contracts.python.Pydantic

import "@model/Model.pkl"

/// One character of a string written inside double quotes in source: a quote, a
/// backslash and every control character or line separator (a raw line feed ends
/// a TypeScript or Python string) as an escape both languages read alike.
local function escapeChar(c: String): String =
  if (c == "\\")
    "\\\\"
  else if (c == "\"")
    "\\\""
  else if (c == "\n")
    "\\n"
  else if (c == "\r")
    "\\r"
  else if (c == "\t")
    "\\t"
  else
    let (cp = c.codePoints.first)
      if (cp < 32 || (cp >= 127 && cp <= 159) || cp == 8232 || cp == 8233)
        "\\u" + cp.toRadixString(16).padStart(4, "0")
      else
        c

/// A string as a double-quoted literal.
local function quote(v: String): String = "\"" + v.chars.map((c) -> escapeChar(c)).join("") + "\""

local function lit(v: Any): String =
  if (v is String)
    quote(v)
  else if (v == null)
    "None"
  else if (v is Boolean)
    (if (v) "True" else "False")
  else if (v is List)
    "[\(v.map((e) -> lit(e)).join(", "))]"
  else if (v is Map)
    "{\(v.entries.map((e) -> "\(lit(e.first)): \(lit(e.second))").join(", "))}"
  else
    "\(v)"

/// Words Python reserves: an attribute cannot be one.
local keywords: Set<String> =
  Set(
    "False",
    "None",
    "True",
    "and",
    "as",
    "assert",
    "async",
    "await",
    "break",
    "class",
    "continue",
    "def",
    "del",
    "elif",
    "else",
    "except",
    "finally",
    "for",
    "from",
    "global",
    "if",
    "import",
    "in",
    "is",
    "lambda",
    "nonlocal",
    "not",
    "or",
    "pass",
    "raise",
    "return",
    "try",
    "while",
    "with",
    "yield",
  )

/// The name a property is declared under: its own when that is a usable
/// attribute. A Python keyword gains a trailing underscore; anything else that is
/// not a plain identifier, or that starts with an underscore (pydantic reads one
/// as private and drops the field), is rewritten to one. Only a name that
/// could not be an attribute at all, or would not be a field, is touched: a name
/// that merely shadows something of `BaseModel`'s works and stays as it is.
local function pyName(name: String): String =
  if (name.matches(Regex("[A-Za-z][A-Za-z0-9_]*")))
    if (keywords.contains(name)) "\(name)_" else name
  else
    let (safe = name.replaceAll(Regex("[^A-Za-z0-9_]"), "_"))
      if (safe.matches(Regex("[A-Za-z].*")))
        if (keywords.contains(safe)) "\(safe)_" else safe
      else
        "f" + (if (safe.startsWith("_")) safe else "_" + safe)

local function rawStr(r: String): String = "r\"\(r.replaceAll("\"", "\\\""))\""

/// A documentation comment as the body of a triple-quoted docstring: a backslash
/// is doubled, a run of three quotes cannot be in it, and a quote at the very end
/// would close the string one quote early.
local function docstring(d: String): String =
  let (e = d.replaceAll("\\", "\\\\").replaceAll("\"\"\"", "'''"))
    if (e.endsWith("\"")) e.dropLast(1) + "\\\"" else e

local function comment(d: String?, indent: String): String =
  if (d == null) "" else d.split("\n").map((l) -> "\(indent)#: \(l)\n").join("")

/// The annotation for a node, referring to aliases and classes by name (a name
/// declared further down is fine: the module defers its annotations).
local function ann(n: Model.Node): String =
  if (n.kind == "object")
    n.alias ?? n.cls.qname
  else if (n.alias != null)
    n.alias
  else
    inner(n)

local function constraints(parts: List<String?>): String = parts.filterNonNull().join(", ")

local function stringType(n: Model.Node): String =
  let (
    sc =
      constraints(
        List(
          if (n.length?.min != null) "min_length=\(n.length.min)" else null,
          if (n.length?.max != null) "max_length=\(n.length.max)" else null,
          if (n.pattern != null) "pattern=\(rawStr(n.pattern.regex))" else null,
        ),
      )
  )
  let (
    parts =
      List(
        if (sc != "") "StringConstraints(\(sc))" else null,
        if (n.pattern != null && !n.multiLine) "AfterValidator(_no_line_break)" else null,
      ).filterNonNull()
        + n.notPatterns.map((p) ->
          "AfterValidator(_not_pattern(\(rawStr(p.regex)), \(lit(p.reason))))"
        )
  )
    if (parts.isEmpty) "str" else "Annotated[str, \(parts.join(", "))]"

/// A list type with the validators its node asks for: the number of its items
/// (`@Items`) and that they are distinct.
local function listType(base: String, n: Model.Node): String =
  let (
    parts =
      List(
        if (n.itemBounds?.min != null || n.itemBounds?.max != null)
          "Field(\(constraints(
            List(
              if (n.itemBounds.min != null) "min_length=\(n.itemBounds.min)" else null,
              if (n.itemBounds.max != null) "max_length=\(n.itemBounds.max)" else null,
            ),
          )))"
        else
          null,
        if (n.itemBounds?.unique == true) "AfterValidator(_distinct)" else null,
      ).filterNonNull()
  )
    if (parts.isEmpty) base else "Annotated[\(base), \(parts.join(", "))]"

local function inner(n: Model.Node): String =
  if (n.kind == "string")
    stringType(n)
  else if (n.kind == "integer")
    "Annotated[int, BeforeValidator(_integral)\(range(n))\(oneOf(n))]"
  else if (n.kind == "number")
    if (n.range == null && n.numericValues == null)
      "float"
    else
      "Annotated[float\(range(n))\(oneOf(n))]"
  else if (n.kind == "boolean")
    "bool"
  else if (n.kind == "enum")
    "Literal[\(n.values.map((v) -> lit(v)).join(", "))]"
  else if (n.kind == "list")
    listType("list[\(ann(n.items))]", n)
  else if (n.kind == "map")
    dict("dict[\(ann(n.key)), \(ann(n.items))]", n)
  else if (n.kind == "open")
    dict("dict[str, Any]", n)
  else if (n.kind == "union")
    n.members.map((m) -> ann(m)).join(" | ")
  else
    "Any"

/// A dictionary type with the validators its node asks for: the number of its
/// entries (`@Properties`), the keys it must carry (`@RequiresKeys`) and the ones
/// it must not (`@DenyKeys`).
local function dict(base: String, n: Model.Node): String =
  let (
    vs =
      List(
        if (n.propertyBounds?.min != null || n.propertyBounds?.max != null)
          "Field(\(constraints(
            List(
              if (n.propertyBounds.min != null) "min_length=\(n.propertyBounds.min)" else null,
              if (n.propertyBounds.max != null) "max_length=\(n.propertyBounds.max)" else null,
            ),
          )))"
        else
          null,
        if (n.requiresKeys != null)
          "AfterValidator(_has_keys(\(lit(n.requiresKeys.keys.toList()))))"
        else
          null,
        if (n.denyKeys != null) "AfterValidator(_deny_keys(\(lit(n.denyKeys))))" else null,
      ).filterNonNull()
  )
    if (vs.isEmpty) base else "Annotated[\(base), \(vs.join(", "))]"

/// The validator that admits only the numbers `@OneOfValues` lists, or nothing.
local function oneOf(n: Model.Node): String =
  if (n.numericValues == null)
    ""
  else
    ", AfterValidator(_one_of(\(lit(n.numericValues))))"

local function range(n: Model.Node): String =
  if (n.range == null)
    ""
  else
    ", Field(\(constraints(
      List(
        if (n.range.min != null) "ge=\(n.range.min)" else null,
        if (n.range.max != null) "le=\(n.range.max)" else null,
        if (n.range.exclusiveMin != null) "gt=\(n.range.exclusiveMin)" else null,
        if (n.range.exclusiveMax != null) "lt=\(n.range.exclusiveMax)" else null,
      ),
    )))"

/// `Field(...)` of a property: its default (or `None`, for an absent optional)
/// and the alias its document key needs, or nothing when it needs neither.
local function fieldCall(p: Model.Prop): String =
  let (alias = if (pyName(p.name) == p.name) null else "alias=\(lit(p.name))")
  let (
    dflt =
      if (p.hasDefault && p.type.kind == "object")
        "default_factory=lambda: \(p.type.alias ?? p.type.cls.qname).model_validate(\(lit(p.default)))"
      else if (p.hasDefault)
        "default=\(lit(p.default))"
      else if (!p.required)
        "default=None"
      else
        null
  )
    if (alias == null)
      if (dflt == null) "" else if (dflt == "default=None") " = None" else " = Field(\(dflt))"
    else
      " = Field(\(constraints(List(dflt, alias))))"

local function field(p: Model.Prop): String =
  comment(p.doc, "    ")
    + "    \(pyName(p.name)): \(ann(p.type))\(if ((!p.required && !p.hasDefault) || p.nullable) " | None" else "")"
    + fieldCall(p)
    + "\n"

/// Two properties of one class that would be declared under one name.
local function collisions(c: Model.Cls): List<String> =
  c.props
    .map((p) -> pyName(p.name))
    .distinct
    .filter((n) -> c.props.count((p) -> pyName(p.name) == n) > 1)
    .map((n) ->
      "\(c.qname): \(c.props.filter((p) -> pyName(p.name) == n).map((p) -> "`\(p.name)`").join(" and ")) are all `\(n)` in Python"
    )

local function classDef(c: Model.Cls): String =
  if (!collisions(c).isEmpty)
    throw(collisions(c).join("\n"))
  else
    classBody(c)

/// The `model_validator` of one class (or alias) for its rules across fields, or
/// nothing. Named for `owner`: a subclass's validator must not replace its base's.
local function conditional(owner: String, conds: List<Model.Condition>): String =
  if (conds.isEmpty)
    ""
  else
    "\n    @model_validator(mode=\"after\")\n"
      + "    def _conditional_\(owner)(self) -> \"\(owner)\":\n"
      + conds
        .map((d) ->
          "        if _at(self, \(lit(d.path.map((k) -> pyName(k))))) \(if (d.unless) "not in" else "in") \(lit(d.values)):\n"
            + "            missing = [\".\".join(p) for p in \(lit(d.paths.map((p) -> p.map((k) -> pyName(k))))) if _at(self, p) is None]\n"
            + "            if missing:\n"
            + "                raise ValueError(\(lit(Model.conditionPhrase(d) + ": missing ")) + \", \".join(missing))\n"
        )
        .join("")
      + "        return self\n"

/// The keys of `c` that admit `null` (`@Nullable`), added to the ones its base
/// has: `_Closed` refuses a `null` anywhere else.
local function nullableKeys(c: Model.Cls): String =
  let (
    own =
      c.props
        .filter((p) -> p.nullable)
        .map((p) -> lit(p.name))
  )
    if (own.isEmpty)
      ""
    else
      "    _nullable: ClassVar[frozenset[str]] = "
        + (if (c.base != null) "\(c.base.cls.qname)._nullable | " else "")
        + "frozenset({\(own.join(", "))})\n"

local function classBody(c: Model.Cls): String =
  "class \(c.qname)(\(if (c.base != null) c.base.cls.qname else "_Closed")):\n"
    + (
      if (c.doc != null)
        "    \"\"\"\(docstring(c.doc))\"\"\"\n"
      else
        ""
    )
    + (
      if (c.isOpen)
        "    model_config = ConfigDict(extra=\"allow\")\n"
      else if (c.base != null)
        "    model_config = ConfigDict(extra=\"forbid\")\n"
      else
        ""
    )
    + nullableKeys(c)
    + (if (c.props.isEmpty) "    pass\n" else c.props.map((p) -> field(p)).join(""))
    + conditional(c.qname, c.conditions)
    + "\n\n"

local function classAliasDef(n: Model.Node): String =
  "class \(n.alias)(\(n.cls.qname)):\n"
    + (if (n.conditions.isEmpty) "    pass\n" else conditional(n.alias, n.conditions))
    + "\n\n"

local header: String =
  #"""
  # Generated from a contract by contracts.python. Do not edit.
  from __future__ import annotations

  import json
  import re
  from typing import Annotated, Any, ClassVar, Literal

  from pydantic import (
      AfterValidator,
      BaseModel,
      BeforeValidator,
      ConfigDict,
      Field,
      StringConstraints,
      model_validator,
  )


  def _no_line_break(value: str) -> str:
      # Every character that ends a line in some engine: LF, CR, FF, VT, NEL, LS, PS.
      if any(c in value for c in "\n\r\f\v\x85\u2028\u2029"):
          raise ValueError("a line break is not allowed")
      return value


  def _not_pattern(pattern: str, reason: str):
      compiled = re.compile(pattern)

      def check(value: str) -> str:
          if compiled.search(value):
              raise ValueError(f"must not match {pattern}: {reason}")
          return value

      return check


  def _one_of(allowed: list[Any]):
      def check(value: Any) -> Any:
          if value not in allowed:
              raise ValueError(f"must be one of {allowed}")
          return value

      return check


  def _canon(value: Any) -> str:
      # JSON with the keys sorted, so that two values that differ only in the
      # order of an object's keys are one value (JSON Schema's equality).
      if isinstance(value, BaseModel):
          value = value.model_dump(mode="json", by_alias=True)
      return json.dumps(value, sort_keys=True, default=str)


  def _distinct(value: list[Any]) -> list[Any]:
      if len({_canon(item) for item in value}) != len(value):
          raise ValueError("items must be distinct")
      return value


  def _integral(value: Any) -> Any:
      # An integral float is an integer (20.0 is 20); a bool, a string or a
      # float with a fractional part is not.
      if isinstance(value, float) and value.is_integer():
          return int(value)
      return value


  def _at(value: Any, path: list[str]) -> Any:
      # The value at a path through blocks; absent on the way is absent.
      for key in path:
          if value is None:
              return None
          value = getattr(value, key, None)
      return value


  def _deny_keys(keys: list[str]):
      def check(value: dict[str, Any]) -> dict[str, Any]:
          found = [k for k in keys if k in value]
          if found:
              raise ValueError(f"must not have the key {found}")
          return value

      return check


  def _has_keys(keys: list[str]):
      def check(value: dict[str, Any]) -> dict[str, Any]:
          missing = [k for k in keys if k not in value]
          if missing:
              raise ValueError(f"missing {missing}")
          return value

      return check


  class _Closed(BaseModel):
      model_config = ConfigDict(extra="forbid", strict=True)

      # The keys that may be `null` (`@Nullable`); a subclass adds to its base's.
      _nullable: ClassVar[frozenset[str]] = frozenset()

      @model_validator(mode="before")
      @classmethod
      def _optional_is_absent_not_null(cls, data: Any) -> Any:
          if isinstance(data, dict):
              for key, value in data.items():
                  if value is None and key not in cls._nullable:
                      raise ValueError(f"{key}: null is not a value; omit the key")
          return data


  """#

/// The Python module for the documents in `roots`.
function render(roots: Mapping<String, Model.Node>): String =
  let (ns = roots.toMap().values.toList())
    header
      + Model.aliases(ns).map((a) -> "\(a.alias) = \(inner(a))\n").join("")
      + "\n\n"
      + Model.classes(ns).map((c) -> classDef(c.cls)).join("")
      + Model.classAliases(ns).map((a) -> classAliasDef(a)).join("")
      + "SCHEMAS: dict[str, type[BaseModel]] = {\n"
      + roots
        .toMap()
        .entries
        .map((e) -> "    \(lit(e.first)): \(e.second.alias ?? e.second.cls.qname),\n")
        .join("")
      + "}\n"
