/// JSON Schema (draft 2020-12) from the intermediate form.
///
/// The vocabulary's annotations become keywords: `@Range` is `minimum` and
/// `maximum`, `@Length` is `minLength` and `maxLength`, `@Pattern` is `pattern`,
/// `@Format` is `format`, `@RequiresKeys` is `required` on an open object,
/// `@DenyKeys` is `propertyNames: { not: { enum: [...] } }`, `@Items` is `minItems`,
/// `maxItems` and `uniqueItems`, `@Properties` is `minProperties` and
/// `maxProperties`, `@NotPattern` is one `not: { pattern }` each under `allOf`, a
/// union is `anyOf` (below), and `@RequiredWhen`
/// and `@RequiredUnless` are an `if` with a `then` or an `else`, over nested
/// `properties` and `required` for a dotted path (`contains` is `type: array` and
/// `contains: { enum }` in the `if`); `@ForbiddenWhen` and `@ForbiddenUnless` the
/// same with `not: { required }`; `@RequiredAnyOf` is an `anyOf` of `required`;
/// `@RequiredWhenDiffers` is one `if` and `then` for each value the reference may
/// have, down through the map's `additionalProperties`. `@Range`'s `exclusiveMin`
/// and `exclusiveMax` are `exclusiveMinimum` and `exclusiveMaximum`. `@Open` leaves
/// out `additionalProperties: false`, and `@Const` is `const`. A map's key type is
/// `propertyNames` WHOLE: its pattern, `@NotPattern`s, length and format, or its
/// enum.
///
/// Semantics every generator of this repository must give, and how this one
/// gives them (decision 0010 of the policy repository):
///
///   - a pattern is a search (`pattern` is one already) and never admits a line
///     break: engines disagree on which characters `$` matches before and `.`
///     stops at (`\n`, `\r`, U+000B, U+000C, U+0085, U+2028, U+2029), so each
///     pattern is paired with `not: { pattern: "[...]" }` over all of them, a
///     class that means the same in ECMAScript, RE2, Python and Java;
///   - a default is any value, an object included: a property's `default` is the
///     JSON of the default the contract gives it;
///   - a property that is set at install is in `required` and has no default, and
///     says so with `x-set-at-install: true` (an annotation: a validator ignores
///     it, a tool reads it instead of parsing the description); one that is only
///     `@Required` is in `required` with no default and no extension key;
///   - an integral float is an integer: `type: integer` says so;
///   - a field with a default is optional: it is not in `required`. So is an object
///     whose class gives every field a default, or leaves it nullable, or holds
///     only such objects (Pkl builds it when the document leaves it out): its
///     `default` is that instance, rendered whole, because a validator does not
///     fill a default in and a reader must still find what it will be;
///   - `null` is not a value for an optional field: a property's type does not
///     include `null`, so `null` is a type error. A property that declares
///     `@Nullable` is the exception: its schema admits `null` (`orNull`, below).
///   - `@MultiLine` leaves out the line-break guard of its node; `@OneOfValues` is
///     an `enum` of numbers.
///   - a union of types is `anyOf`, never `oneOf`. Pkl accepts a value that
///     conforms to ANY member of a union, and so must the schema. `oneOf` also
///     refuses a value that conforms to two members; where the members cannot
///     overlap (a string and an object, a list and a scalar) the two keywords
///     accept the same documents and `anyOf` is the cheaper to evaluate, and
///     where they can (two closed classes whose properties are all optional both
///     admit `{}`) `oneOf` would refuse what Pkl accepts. A union of plain
///     scalars is `type: [...]`. A hand-written schema that says `oneOf` over
///     members that cannot overlap is therefore matched by the generated `anyOf`,
///     document for document.
module contracts.jsonschema.JsonSchema

import "@model/Model.pkl"

/// The dialect every document declares.
const schemaUri = "https://json-schema.org/draft/2020-12/schema"

local const function bounds(d: Dynamic, r: Dynamic?): Dynamic = (d) {
  when (r?.min != null) { minimum = r.min }
  when (r?.max != null) { maximum = r.max }
  when (r?.exclusiveMin != null) { exclusiveMinimum = r.exclusiveMin }
  when (r?.exclusiveMax != null) { exclusiveMaximum = r.exclusiveMax }
}

/// `d` with the `enum` of the numbers a node may be (`@OneOfValues`), if it has any.
local const function withValues(d: Dynamic, n: Model.Node): Dynamic = (d) {
  when (n.numericValues != null) { `enum` = n.numericValues }
}

/// What a string node says, as keywords: its length, its pattern (with the
/// line-break guard), its format and the expressions it must not match
/// (`@NotPattern`, one `not: { pattern }` each under `allOf`, because a schema has
/// `not` once and the guard is already it). The `type` is the caller's: a property
/// is `type: string`, and a key (`propertyNames`) is a string already.
local function stringRules(n: Model.Node): Dynamic = new Dynamic {
  when (n.length?.min != null) { minLength = n.length.min }
  when (n.length?.max != null) { maxLength = n.length.max }
  when (n.pattern != null) {
    pattern = n.pattern.regex
    // The guard stays unless the contract declared the value multi-line.
    when (!n.multiLine) { not = noLineBreak }
  }
  when (n.format != null) { format = n.format.name }
  when (!n.notPatterns.isEmpty) {
    allOf = n.notPatterns.map((p) -> new Dynamic { not = new Dynamic { pattern = p.regex } })
  }
}

/// The schema of a map's key type, or null when it says nothing: a string's rules
/// (all of them: pattern, `@NotPattern`, length, format), an enum's members, a
/// union's `anyOf`. The model refuses a key annotation that is none of these.
local function keySchema(k: Model.Node): Dynamic? =
  if (k.kind == "enum")
    new Dynamic { `enum` = k.values }
  else if (k.kind == "string")
    let (r = stringRules(k))
      if (r.toMap().isEmpty) null else r
  else if (k.kind == "union")
    let (ms = k.members.map((m) -> keySchema(m)))
      // A member that says nothing admits every key, and so does the union.
      if (ms.any((m) -> m == null)) null else new Dynamic { anyOf = ms }
  else
    null

/// `propertyNames` for a map or an open object: what its key type says and the
/// keys `@DenyKeys` refuses, as one schema, joined by `allOf` when there are
/// several (both need `not`, which a schema has once).
local function propertyNames(n: Model.Node): Dynamic? =
  let (
    parts =
      (
        if (n.kind == "map" && keySchema(n.key) != null)
          List(keySchema(n.key))
        else
          List()
      )
        + (
          if (n.denyKeys == null)
            List()
          else
            List(new Dynamic { not = new Dynamic { `enum` = n.denyKeys } })
        )
  )
    if (parts.isEmpty)
      null
    else if (parts.length == 1)
      parts.first
    else
      new Dynamic { allOf = parts }

/// The keywords that say "no line break anywhere", which hold whatever the
/// engine does with `$` and `.`.
local noLineBreak: Dynamic = new Dynamic { pattern = Model.lineBreakClass }

/// The schema of a node used as a property type or an item type.
function ofNode(n: Model.Node): Dynamic =
  if (n.def != null)
    new Dynamic { ["$ref"] = "#/$defs/\(n.def.name)" }
  else if (n.schema != null)
    new Dynamic { ["$ref"] = n.schema.id }
  else
    body(n)

local function body(n: Model.Node): Dynamic =
  if (n.constant != null)
    // The value says the type; a union of it with an object is `anyOf` below.
    new Dynamic { `const` = n.constant.value }
  else if (n.kind == "enum")
    new Dynamic { `enum` = n.values }
  else if (n.kind == "string")
    (new Dynamic { type = "string" }) { ...stringRules(n) }
  else if (n.kind == "integer")
    withValues(bounds(new Dynamic { type = "integer" }, n.range), n)
  else if (n.kind == "number")
    withValues(bounds(new Dynamic { type = "number" }, n.range), n)
  else if (n.kind == "boolean")
    new Dynamic { type = "boolean" }
  else if (n.kind == "list")
    (new Dynamic { type = "array"; items = ofNode(n.items) }) {
      when (n.itemBounds?.min != null) { minItems = n.itemBounds.min }
      when (n.itemBounds?.max != null) { maxItems = n.itemBounds.max }
      when (n.itemBounds?.unique == true) { uniqueItems = true }
    }
  else if (n.kind == "map")
    (new Dynamic { type = "object" }) {
      when (propertyNames(n) != null) { propertyNames = propertyNames(n) }
      when (n.items.kind != "any") { additionalProperties = ofNode(n.items) }
      when (n.propertyBounds?.min != null) { minProperties = n.propertyBounds.min }
      when (n.propertyBounds?.max != null) { maxProperties = n.propertyBounds.max }
    }
  else if (n.kind == "open")
    (new Dynamic { type = "object" }) {
      when (n.requiresKeys != null) { required = n.requiresKeys.keys.toList() }
      when (propertyNames(n) != null) { propertyNames = propertyNames(n) }
      when (n.propertyBounds?.min != null) { minProperties = n.propertyBounds.min }
      when (n.propertyBounds?.max != null) { maxProperties = n.propertyBounds.max }
    }
  else if (n.kind == "union")
    // `type: [...]` says only what each member IS, so it serves members that are a
    // plain scalar (or an open object with nothing required). A list, a map, an
    // enum, a class or anything with a constraint on it needs its own schema, or
    // the items, the keys and the bound are lost and the union accepts more than
    // the contract does.
    if (
      n.members.every((m) ->
        m.pattern == null
          && m.range == null
          && m.length == null
          && m.format == null
          && m.notPatterns.isEmpty
          && m.itemBounds == null
          && m.propertyBounds == null
          && m.requiresKeys == null
          && m.constant == null
          && m.kind != "enum"
          && m.kind != "object"
          && m.kind != "list"
          && m.kind != "map"
          && m.kind != "any"
      )
    )
      new Dynamic { type = n.members.map((m) -> body(m).type) }
    else
      new Dynamic { anyOf = n.members.map((m) -> ofNode(m)) }
  else if (n.kind == "object")
    (objectBody(n.cls, closer(n.cls))) {
      when (!conditionsOf(n).isEmpty) { allOf = conditionsOf(n).map((c) -> conditional(c)) }
    }
  else
    new Dynamic {}

/// The keyword that refuses an undeclared key of an object class, or empty for a
/// class that admits them (`@Open`).
function closer(c: Model.Cls): String = if (c.undeclaredKeys) "" else "additionalProperties"

/// The schema a `@Def` node is stored under in `$defs`: its own body, whereas
/// `ofNode` of it is the `$ref` to that entry.
function definition(d: Model.Node): Dynamic = body(d)

/// The rules across fields of an object node: the ones its alias carries and the
/// ones its class (or module) does.
local function conditionsOf(n: Model.Node): List<Model.Condition> = n.conditions + n.cls.conditions

/// A schema that holds when the value at `path` is there: `required` and
/// `properties` at each step, down to `leaf`, which says what the value at the
/// end may be (absent for "it is there, whatever it is").
local function along(path: List<String>, leaf: Dynamic?): Dynamic = new Dynamic {
  when (path.length > 1 || leaf != null) {
    properties = new Dynamic {
      [path.first] = if (path.length > 1) along(path.drop(1), leaf) else leaf
    }
  }
  required = List(path.first)
}

/// The schema that says every path of `paths` is present: the paths' common
/// steps share one `properties` object, and each level `required`s the names
/// that run through or end at it.
local function present(paths: List<List<String>>): Dynamic =
  let (names = paths.map((p) -> p.first).distinct)
  let (deeper = names.filter((n) -> paths.any((p) -> p.first == n && p.length > 1)))
    new Dynamic {
      when (!deeper.isEmpty) {
        properties = new Dynamic {
          for (n in deeper) {
            [n] =
              present(
                paths
                  .filter((p) -> p.first == n && p.length > 1)
                  .map((p) -> p.drop(1)),
              )
          }
        }
      }
      required = names
    }

/// A schema that says the value at `path` is what `leaf` says, WITHOUT requiring
/// it to be there: `properties` at each step. Used where the surrounding rule has
/// already decided the path matters (the entries of a map below a step).
local function through(path: List<String>, leaf: Dynamic): Dynamic = new Dynamic {
  properties = new Dynamic {
    [path.first] = if (path.length > 1) through(path.drop(1), leaf) else leaf
  }
}

/// The schema that says no path of `paths` is present: each one is absent (a
/// dotted path is absent when any step of it is).
local function absent(paths: List<List<String>>): Dynamic =
  if (paths.length == 1)
    new Dynamic { not = present(paths) }
  else
    new Dynamic { not = new Dynamic { anyOf = paths.map((p) -> present(List(p))) } }

/// The condition of a rule that tests a value (`@RequiredWhen` and the others): the
/// value at the path is one of those listed, or, for `contains`, an array that
/// holds one of them. It holds only where every step of the path is there.
local function holds(r: Model.Condition): Dynamic =
  along(
    r.path,
    if (r.`test` == "contains")
      new Dynamic {
        type = "array"
        contains = new Dynamic { `enum` = r.`values` }
      }
    else
      new Dynamic { `enum` = r.`values` },
  )

/// `@RequiredWhenDiffers`: JSON Schema cannot compare two values, so the rule is
/// written once for each value the reference may have. Where the reference is `m`,
/// every entry of the map that sets its value and sets it to something else needs
/// the paths.
local function differs(r: Model.Condition): Dynamic = new Dynamic {
  allOf =
    r.`values`.map((m) -> new Dynamic {
      `if` = along(r.path, new Dynamic { `const` = m })
      then =
        through(r.eachPath, new Dynamic {
          additionalProperties = new Dynamic {
            `if` = along(r.entryPath, new Dynamic { not = new Dynamic { `const` = m } })
            then = present(r.paths)
          }
        })
    })
}

/// A rule across fields. A value test (`@RequiredWhen`, `@RequiredUnless`,
/// `@ForbiddenWhen`, `@ForbiddenUnless`) is an `if` that holds only where every
/// step of the path is there and the value is one of those listed (or the array
/// holds one), so a document that leaves it out does not match. `When` then
/// requires (or forbids) the paths; `Unless` does in the `else`. `@RequiredAnyOf`
/// is an `anyOf` of one `required` each, and `@RequiredWhenDiffers` is `differs`.
local function conditional(r: Model.Condition): Dynamic =
  if (r.kind == "anyOf")
    new Dynamic { anyOf = r.paths.map((p) -> present(List(p))) }
  else if (r.kind == "differs")
    differs(r)
  else
    let (effect = if (r.kind == "forbid") absent(r.paths) else present(r.paths))
      if (r.unless)
        new Dynamic {
          `if` = holds(r)
          `else` = effect
        }
      else
        new Dynamic {
          `if` = holds(r)
          then = effect
        }

/// The schema `{ type: "null" }`, a member of the `anyOf` of a nullable property
/// whose type cannot take the `type: [<t>, "null"]` form.
local nullSchema: Dynamic = new Dynamic { type = "null" }

/// `s`, the schema of a property's type, widened to admit `null` as well
/// (`@Nullable`). Two forms, chosen by what `s` is, and both mean "the value is
/// null or satisfies `s`" in every engine:
///
///   - `s` has a `type` keyword (a scalar, a list, a map, an object, a union of
///     scalars): `"null"` joins the `type` list, and joins the `enum` when there
///     is one. The other keywords (`minimum`, `pattern`, `items`, `properties`)
///     apply to an instance of their own type only, so they let `null` through;
///   - `s` is a `$ref` or an `anyOf` (a document, a definition, a union with a
///     member that needs its own schema), or an `enum` with no `type` (a string
///     enum): a `$ref` is wrapped, `{ type: "null" }` is added to an `anyOf`, and
///     `null` to an `enum`.
local function orNull(s: Dynamic): Dynamic =
  let (m = s.toMap())
    if (m.containsKey("$ref") || m.containsKey("const"))
      new Dynamic { anyOf = List(s, nullSchema) }
    else if (m.containsKey("anyOf"))
      (s) { anyOf = s.anyOf.toList() + List(nullSchema) }
    else if (m.containsKey("type"))
      (s) {
        type = (if (s.type is List) s.type else List(s.type)) + List("null")
        when (m.containsKey("enum")) { `enum` = s.`enum`.toList() + List(null) }
      }
    else if (m.containsKey("enum"))
      (s) { `enum` = s.`enum`.toList() + List(null) }
    else
      s

local function propSchema(p: Model.Prop): Dynamic = (
  if (p.nullable) orNull(ofNode(p.type)) else ofNode(p.type)
) {
  when (p.doc != null) { description = p.doc }
  when (p.hasDefault) { ["default"] = p.default }
  when (p.setAtInstall) { ["x-set-at-install"] = true }
}

/// The `type: object` part of a class: its properties, which are required,
/// and whether an undeclared key is refused (`closer` names the keyword that
/// refuses it, or is empty for an open class).
function objectBody(c: Model.Cls, closer: String): Dynamic =
  let (
    req =
      c.props
        .filter((p) -> p.required)
        .map((p) -> p.name)
  )
    new Dynamic {
      type = "object"
      when (closer != "") { [closer] = false }
      when (!req.isEmpty) { required = req }
      properties = new Dynamic {
        for (p in c.props) {
          [p.name] = propSchema(p)
        }
      }
    }

/// The rules across fields a class (or a chart's values module) carries, as the
/// `allOf` members that say them.
function conditions(c: Model.Cls): List<Dynamic> = c.conditions.map((r) -> conditional(r))

/// A whole document: `$schema`, `$id`, the object, what it extends, its
/// conditionals and its `$defs`.
function document(n: Model.Node): Dynamic = documentIn(n, true)

/// `standalone: false` omits `$schema`, as for a document embedded under
/// `$defs` of another.
function documentIn(n: Model.Node, standalone: Boolean): Dynamic =
  let (
    defs =
      Model
        .walkOwn(n)
        .filter((d) -> d.def != null)
        .distinctBy((d) -> d.def.name)
  )
  let (hasBase = n.cls.base != null)
  let (
    inner =
      objectBody(
        n.cls,
        if (n.cls.isOpen || n.cls.undeclaredKeys)
          ""
        else if (hasBase)
          "unevaluatedProperties"
        else
          "additionalProperties",
      )
  )
    new Dynamic {
      when (standalone) { ["$schema"] = schemaUri }
      ["$id"] = n.schema.id
      when (n.schema.title != null) { title = n.schema.title }
      when ((n.cls.doc ?? n.doc) != null) { description = n.cls.doc ?? n.doc }
      when (hasBase || !conditionsOf(n).isEmpty) {
        allOf =
          (if (hasBase) List(new Dynamic { ["$ref"] = n.cls.base.schema.id }) else List())
            + conditionsOf(n).map((c) -> conditional(c))
      }
      ...inner
      when (!defs.isEmpty) {
        ["$defs"] = new Dynamic {
          for (d in defs) {
            [d.def.name] = body(d)
          }
        }
      }
    }
