/// JSON Schema (draft 2020-12) from the intermediate form.
///
/// The vocabulary's annotations become keywords: `@Range` is `minimum` and
/// `maximum`, `@Length` is `minLength` and `maxLength`, `@Pattern` is `pattern`,
/// `@Format` is `format`, `@RequiresKeys` is `required` on an open object,
/// `@DenyKeys` is `propertyNames: { not: { enum: [...] } }`, `@Items` is `minItems`,
/// `maxItems` and `uniqueItems`, `@Properties` is `minProperties` and
/// `maxProperties`, `@NotPattern` is one `not: { pattern }` each under `allOf`, a
/// union is `anyOf` (below), and `@RequiredWhen`
/// and `@RequiredUnless` are an `if` with a `then` or an `else`, over nested
/// `properties` and `required` for a dotted path. `@Range`'s `exclusiveMin` and
/// `exclusiveMax` are `exclusiveMinimum` and `exclusiveMaximum`.
///
/// Semantics every generator of this repository must give, and how this one
/// gives them (decision 0010 of the policy repository):
///
///   - a pattern is a search (`pattern` is one already) and never admits a line
///     break: engines disagree on which characters `$` matches before and `.`
///     stops at (`\n`, `\r`, U+000B, U+000C, U+0085, U+2028, U+2029), so each
///     pattern is paired with `not: { pattern: "[...]" }` over all of them, a
///     class that means the same in ECMAScript, RE2, Python and Java;
///   - a default is any value, an object included: a property's `default` is the
///     JSON of the default the contract gives it;
///   - a property that is set at install is in `required` and has no default, and
///     says so with `x-set-at-install: true` (an annotation: a validator ignores
///     it, a tool reads it instead of parsing the description);
///   - an integral float is an integer: `type: integer` says so;
///   - a field with a default is optional: it is not in `required`. So is an object
///     whose class gives every field a default, or leaves it nullable, or holds
///     only such objects (Pkl builds it when the document leaves it out): its
///     `default` is that instance, rendered whole, because a validator does not
///     fill a default in and a reader must still find what it will be;
///   - `null` is not a value for an optional field: a property's type does not
///     include `null`, so `null` is a type error.
///   - a union of types is `anyOf`, never `oneOf`. Pkl accepts a value that
///     conforms to ANY member of a union, and so must the schema. `oneOf` also
///     refuses a value that conforms to two members; where the members cannot
///     overlap (a string and an object, a list and a scalar) the two keywords
///     accept the same documents and `anyOf` is the cheaper to evaluate, and
///     where they can (two closed classes whose properties are all optional both
///     admit `{}`) `oneOf` would refuse what Pkl accepts. A union of plain
///     scalars is `type: [...]`. A hand-written schema that says `oneOf` over
///     members that cannot overlap is therefore matched by the generated `anyOf`,
///     document for document.
module contracts.jsonschema.JsonSchema

import "@model/Model.pkl"

/// The dialect every document declares.
const schemaUri = "https://json-schema.org/draft/2020-12/schema"

local const function bounds(d: Dynamic, r: Dynamic?): Dynamic = (d) {
  when (r?.min != null) { minimum = r.min }
  when (r?.max != null) { maximum = r.max }
  when (r?.exclusiveMin != null) { exclusiveMinimum = r.exclusiveMin }
  when (r?.exclusiveMax != null) { exclusiveMaximum = r.exclusiveMax }
}

/// `propertyNames` for a map or an open object: what its key type says (a
/// pattern, an enum) and the keys `@DenyKeys` refuses, as one schema, joined by
/// `allOf` when there are several (both need `not`, which a schema has once).
local function propertyNames(n: Model.Node): Dynamic? =
  let (
    parts =
      (
        if (n.kind == "map" && n.key.pattern != null)
          List(new Dynamic { pattern = n.key.pattern.regex; not = noLineBreak })
        else
          List()
      )
        + (
          if (n.kind == "map" && n.key.kind == "enum")
            List(new Dynamic { `enum` = n.key.values })
          else
            List()
        )
        + (
          if (n.denyKeys == null)
            List()
          else
            List(new Dynamic { not = new Dynamic { `enum` = n.denyKeys } })
        )
  )
    if (parts.isEmpty)
      null
    else if (parts.length == 1)
      parts.first
    else
      new Dynamic { allOf = parts }

/// The keywords that say "no line break anywhere", which hold whatever the
/// engine does with `$` and `.`.
local noLineBreak: Dynamic = new Dynamic { pattern = Model.lineBreakClass }

/// The schema of a node used as a property type or an item type.
function ofNode(n: Model.Node): Dynamic =
  if (n.def != null)
    new Dynamic { ["$ref"] = "#/$defs/\(n.def.name)" }
  else if (n.schema != null)
    new Dynamic { ["$ref"] = n.schema.id }
  else
    body(n)

local function body(n: Model.Node): Dynamic =
  if (n.kind == "enum")
    new Dynamic { `enum` = n.values }
  else if (n.kind == "string")
    (new Dynamic { type = "string" }) {
      when (n.length?.min != null) { minLength = n.length.min }
      when (n.length?.max != null) { maxLength = n.length.max }
      when (n.pattern != null) {
        pattern = n.pattern.regex
        not = noLineBreak
      }
      when (n.format != null) { format = n.format.name }
      // `@NotPattern`: one `not: { pattern }` for each rule, joined by `allOf`
      // because a schema has `not` once and the line-break guard is already it.
      when (!n.notPatterns.isEmpty) {
        allOf = n.notPatterns.map((p) -> new Dynamic { not = new Dynamic { pattern = p.regex } })
      }
    }
  else if (n.kind == "integer")
    bounds(new Dynamic { type = "integer" }, n.range)
  else if (n.kind == "number")
    bounds(new Dynamic { type = "number" }, n.range)
  else if (n.kind == "boolean")
    new Dynamic { type = "boolean" }
  else if (n.kind == "list")
    (new Dynamic { type = "array"; items = ofNode(n.items) }) {
      when (n.itemBounds?.min != null) { minItems = n.itemBounds.min }
      when (n.itemBounds?.max != null) { maxItems = n.itemBounds.max }
      when (n.itemBounds?.unique == true) { uniqueItems = true }
    }
  else if (n.kind == "map")
    (new Dynamic { type = "object" }) {
      when (propertyNames(n) != null) { propertyNames = propertyNames(n) }
      when (n.items.kind != "any") { additionalProperties = ofNode(n.items) }
      when (n.propertyBounds?.min != null) { minProperties = n.propertyBounds.min }
      when (n.propertyBounds?.max != null) { maxProperties = n.propertyBounds.max }
    }
  else if (n.kind == "open")
    (new Dynamic { type = "object" }) {
      when (n.requiresKeys != null) { required = n.requiresKeys.keys.toList() }
      when (propertyNames(n) != null) { propertyNames = propertyNames(n) }
      when (n.propertyBounds?.min != null) { minProperties = n.propertyBounds.min }
      when (n.propertyBounds?.max != null) { maxProperties = n.propertyBounds.max }
    }
  else if (n.kind == "union")
    // `type: [...]` says only what each member IS, so it serves members that are a
    // plain scalar (or an open object with nothing required). A list, a map, an
    // enum, a class or anything with a constraint on it needs its own schema, or
    // the items, the keys and the bound are lost and the union accepts more than
    // the contract does.
    if (
      n.members.every((m) ->
        m.pattern == null
          && m.range == null
          && m.length == null
          && m.format == null
          && m.notPatterns.isEmpty
          && m.itemBounds == null
          && m.propertyBounds == null
          && m.requiresKeys == null
          && m.kind != "enum"
          && m.kind != "object"
          && m.kind != "list"
          && m.kind != "map"
          && m.kind != "any"
      )
    )
      new Dynamic { type = n.members.map((m) -> body(m).type) }
    else
      new Dynamic { anyOf = n.members.map((m) -> ofNode(m)) }
  else if (n.kind == "object")
    (objectBody(n.cls, "additionalProperties")) {
      when (!conditionsOf(n).isEmpty) { allOf = conditionsOf(n).map((c) -> conditional(c)) }
    }
  else
    new Dynamic {}

/// The rules across fields of an object node: the ones its alias carries and the
/// ones its class (or module) does.
local function conditionsOf(n: Model.Node): List<Model.Condition> = n.conditions + n.cls.conditions

/// A schema that holds when the value at `path` is there: `required` and
/// `properties` at each step, down to `leaf`, which says what the value at the
/// end may be (absent for "it is there, whatever it is").
local function along(path: List<String>, leaf: Dynamic?): Dynamic = new Dynamic {
  when (path.length > 1 || leaf != null) {
    properties = new Dynamic {
      [path.first] = if (path.length > 1) along(path.drop(1), leaf) else leaf
    }
  }
  required = List(path.first)
}

/// The schema that says every path of `paths` is present: the paths' common
/// steps share one `properties` object, and each level `required`s the names
/// that run through or end at it.
local function present(paths: List<List<String>>): Dynamic =
  let (names = paths.map((p) -> p.first).distinct)
  let (deeper = names.filter((n) -> paths.any((p) -> p.first == n && p.length > 1)))
    new Dynamic {
      when (!deeper.isEmpty) {
        properties = new Dynamic {
          for (n in deeper) {
            [n] =
              present(
                paths
                  .filter((p) -> p.first == n && p.length > 1)
                  .map((p) -> p.drop(1)),
              )
          }
        }
      }
      required = names
    }

/// A rule across fields (`@RequiredWhen`, `@RequiredUnless`). The condition is an
/// `if` that holds only where every step of the path is there and the value is
/// one of those listed, so a document that leaves it out does not match. `When`
/// then requires the paths; `Unless` requires them in the `else`.
local function conditional(r: Model.Condition): Dynamic =
  let (test = along(r.path, new Dynamic { `enum` = r.values }))
    if (r.unless)
      new Dynamic {
        `if` = test
        `else` = present(r.paths)
      }
    else
      new Dynamic {
        `if` = test
        then = present(r.paths)
      }

local function propSchema(p: Model.Prop): Dynamic = (ofNode(p.type)) {
  when (p.doc != null) { description = p.doc }
  when (p.hasDefault) { ["default"] = p.default }
  when (p.setAtInstall) { ["x-set-at-install"] = true }
}

/// The `type: object` part of a class: its properties, which are required,
/// and whether an undeclared key is refused (`closer` names the keyword that
/// refuses it, or is empty for an open class).
function objectBody(c: Model.Cls, closer: String): Dynamic =
  let (
    req =
      c.props
        .filter((p) -> p.required)
        .map((p) -> p.name)
  )
    new Dynamic {
      type = "object"
      when (closer != "") { [closer] = false }
      when (!req.isEmpty) { required = req }
      properties = new Dynamic {
        for (p in c.props) {
          [p.name] = propSchema(p)
        }
      }
    }

/// The rules across fields a class (or a chart's values module) carries, as the
/// `allOf` members that say them.
function conditions(c: Model.Cls): List<Dynamic> = c.conditions.map((r) -> conditional(r))

/// A whole document: `$schema`, `$id`, the object, what it extends, its
/// conditionals and its `$defs`.
function document(n: Model.Node): Dynamic = documentIn(n, true)

/// `standalone: false` omits `$schema`, as for a document embedded under
/// `$defs` of another.
function documentIn(n: Model.Node, standalone: Boolean): Dynamic =
  let (
    defs =
      Model
        .walkOwn(n)
        .filter((d) -> d.def != null)
        .distinctBy((d) -> d.def.name)
  )
  let (hasBase = n.cls.base != null)
  let (
    inner =
      objectBody(
        n.cls,
        if (n.cls.isOpen) "" else if (hasBase) "unevaluatedProperties" else "additionalProperties",
      )
  )
    new Dynamic {
      when (standalone) { ["$schema"] = schemaUri }
      ["$id"] = n.schema.id
      when (n.schema.title != null) { title = n.schema.title }
      when ((n.cls.doc ?? n.doc) != null) { description = n.cls.doc ?? n.doc }
      when (hasBase || !conditionsOf(n).isEmpty) {
        allOf =
          (if (hasBase) List(new Dynamic { ["$ref"] = n.cls.base.schema.id }) else List())
            + conditionsOf(n).map((c) -> conditional(c))
      }
      ...inner
      when (!defs.isEmpty) {
        ["$defs"] = new Dynamic {
          for (d in defs) {
            [d.def.name] = body(d)
          }
        }
      }
    }
