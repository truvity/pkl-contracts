/// Writes a Pkl module with one optional property for every type alias and every
/// class of the vocabulary, so that the compatibility check (`hack/compat.sh`)
/// generates a JSON Schema in which each of them appears once, and a change to any
/// one of them (a narrowed pattern, a removed member, a removed type) is classified
/// by `packages/jsonschema/Compatibility.pkl` like a change to a contract's own
/// field.
///
/// It reflects on the vocabulary of the checkout it runs in, so that the release
/// side of the check is probed with the release's own types and a type that no
/// longer exists is a removed property. It is copied into the project it runs in
/// (`examples/service/.compat/`), because a module must be inside the project to
/// resolve `@vocab`; nothing of that is committed.
///
///     pkl eval --project-dir examples/service -o Probe.pkl examples/service/.compat/Gen.pkl
module compat.Gen

import "pkl:reflect"

import "@vocab/Vocab.pkl"

local mirror = reflect.Module(Vocab)

/// The types a contract can name: the aliases, then the classes, each sorted by
/// name so that the module is the same on every run.
local names: List<String> =
  mirror.typeAliases.keys.toList().sort()
    + mirror.classes.keys.toList().filter((k) -> k != "ModuleClass").sort()

output {
  text =
    """
    /// Generated by hack/vocab-probe.pkl. One optional property for each type of the vocabulary.
    @A.Schema { id = "https://example.com/schemas/vocab-probe.json"; title = "vocab-probe" }
    module compat.Probe

    import "@vocab/Annotations.pkl" as A
    import "@vocab/Vocab.pkl" as V

    """
      + names.map((n) -> "\n/// The vocabulary's `\(n)`.\n\(n): V.\(n)?\n").join("")
}
