{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/echo/schemas/config.json",
  "title": "echo",
  "description": "An example service that serves one listener and keeps a record in a\nPostgreSQL database. Its configuration is the service envelope (probes, log,\ndrain) and what it needs of its own.",
  "allOf": [
    {
      "$ref": "https://github.com/truvity/policy/schemas/service.json"
    }
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "listen",
    "postgres"
  ],
  "properties": {
    "listen": {
      "$ref": "https://github.com/truvity/policy/schemas/fragments/listen.json",
      "description": "The listener the service's own traffic is served on."
    },
    "postgres": {
      "$ref": "https://github.com/truvity/policy/schemas/fragments/postgres.json",
      "description": "The database the service keeps its records in."
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1,
          "description": "Days before it is deleted.",
          "default": 7
        },
        "keepForever": {
          "type": "boolean",
          "description": "Keep it until somebody deletes it, whatever `days` says.",
          "default": false
        }
      },
      "description": "How long what the service keeps is kept. A default that is a class, which\ndiffers from the class's own in `days`.",
      "default": {
        "days": 30,
        "keepForever": false
      }
    },
    "labels": {
      "type": "object",
      "description": "Labels put on what the service writes. A default that is an open object.",
      "default": {
        "team": "platform"
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "description": "The bucket. Every install names its own, so the defaults leave it out and the\nschema requires it.",
          "x-set-at-install": true
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "description": "What every object's key begins with.",
          "default": "echo/requests"
        },
        "batchSeconds": {
          "type": "integer",
          "minimum": 10,
          "description": "How often a batch is written, in seconds: not more often than every ten.",
          "default": 60
        }
      },
      "description": "Where the service archives what it served. Absent means it does not."
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether the install only renders the rules, for another cluster to evaluate.",
              "default": false
            }
          },
          "description": "Where the rules are evaluated. Absent means in this cluster."
        },
        "holdFor": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          },
          "description": "How long a condition holds before it fires.",
          "default": "10m"
        },
        "errorRatio": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0,
          "description": "The share of requests that may fail before it fires: more than none, at most\nall of them.",
          "default": 0.05
        },
        "latencySeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The slowest a request may be, in seconds: more than zero.",
          "default": 0.5
        },
        "codes": {
          "type": "string",
          "pattern": "^[A-Z_]+(\\|[A-Z_]+)*$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          },
          "description": "The status codes that count as failures, joined by a bar.",
          "default": "INTERNAL|UNAVAILABLE"
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          },
          "description": "The namespace the rules are evaluated in. Absent means the install's own."
        },
        "tls": {
          "enum": [
            "off",
            "permissive"
          ],
          "description": "How the rules' gateway treats mutual TLS.",
          "default": "off"
        },
        "alertLabels": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "severity"
              ]
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Labels put on every alert. `severity` is the rules' own and may not be set here.",
          "default": {}
        },
        "receiver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "description": "The receiver's URL."
            }
          },
          "description": "Who is told. Needed unless the rules are only rendered."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "remote": {
                "properties": {
                  "enabled": {
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "remote"
            ]
          },
          "else": {
            "properties": {
              "receiver": {
                "required": [
                  "url"
                ]
              }
            },
            "required": [
              "receiver"
            ]
          }
        }
      ],
      "description": "Alerting on the service's own error budget. Absent means no rules."
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "How long one call may take, in seconds.",
          "default": 5
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "description": "How many attempts in all.",
              "default": 3
            },
            "idempotentOnly": {
              "type": "boolean",
              "description": "Whether a call that is not safe to repeat is repeated too.",
              "default": true
            }
          },
          "description": "What is tried again.",
          "default": {
            "attempts": 3,
            "idempotentOnly": true
          }
        },
        "proxy": {
          "type": "string",
          "minLength": 1,
          "description": "A proxy to go through; absent means none."
        }
      },
      "description": "How the service calls out. Every field of it has a default, and so has the\n`retry` block inside it, so the whole block may be left out of a document.",
      "default": {
        "timeoutSeconds": 5,
        "retry": {
          "attempts": 3,
          "idempotentOnly": true
        }
      }
    }
  }
}
