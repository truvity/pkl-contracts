/// The defaults the worked example's contract declares, as JSON, for
/// `hack/defaults-check.py`: which property of which class (and document, and
/// chart path) has which default. It is the one place the expectation comes
/// from, Pkl's own reflection, so that a generator that drops a default is
/// measured against the contract and not against its own output.
///
///     pkl eval --project-dir examples/service -f json examples/service/Defaults.pkl
module example.Defaults

import "@model/Model.pkl"

import "Chart.pkl"
import "Config.pkl"

local chartNode: Model.Node = Model.chartOf(Chart)!!
local docs: Mapping<String, Model.Node> = Model.documents(List(Config, Chart))

/// The defaults of every class in `n` that is not another document, as
/// [property, default] pairs, sorted.
local function ownDefaults(n: Model.Node): List<List<Any>> =
  Model
    .walkOwn(n)
    .filter((m) -> m.kind == "object" && (m.schema == null || m == n))
    .flatMap((m) -> m.cls.props)
    .filter((p) -> p.hasDefault)
    .map((p) -> List(p.name, p.default))
    .sortBy((e) -> e[0] as String)

/// The defaults at chart paths, for `values.yaml`. Where an object was given a
/// default of its own, what is under it is that default's, not the class's:
/// `over` is the object's default.
local function paths(prefix: String, c: Model.Cls, over: Map?): List<Dynamic> =
  c.props.flatMap((p) ->
    let (dotted = if (prefix == "") p.name else "\(prefix).\(p.name)")
    let (has = (over != null && over.containsKey(p.name)) || p.hasDefault)
    let (value = if (over != null && over.containsKey(p.name)) over[p.name] else p.default)
      (if (has) List(new Dynamic { path = dotted; ["default"] = value }) else List())
        + (
          if (p.type.kind == "object")
            paths(dotted, p.type.cls, if (has && value is Map) value else null)
          else
            List()
        )
  )

/// The chart paths of every property that is set at install.
local function atInstall(prefix: String, c: Model.Cls): List<String> =
  c.props.flatMap((p) ->
    let (dotted = if (prefix == "") p.name else "\(prefix).\(p.name)")
      (if (p.setAtInstall) List(dotted) else List())
        + (if (p.type.kind == "object") atInstall(dotted, p.type.cls) else List())
  )

/// The classes the generators that write one type per class (zod, pydantic, the
/// reference) write: those of the documents. A chart's own classes are in its
/// values schema and `values.yaml`, which the other checks read.
local all: List<Model.Node> = Model.classes(docs.toMap().values.toList())

output {
  renderer = new JsonRenderer { omitNullProperties = false }
  value = new Dynamic {
    // Per document key: its `$id` and the defaults inside it.
    documents =
      docs.toMap().mapValues((_, n) -> new Dynamic { id = n.schema.id; defaults = ownDefaults(n) })
    // The chart's own (root) properties' defaults.
    chartRoot = ownDefaults(chartNode)
    // Per class (qname): property to default.
    classes =
      all.toMap(
        (n) -> n.cls.qname,
        (n) ->
          n.cls.props
            .filter((p) -> p.hasDefault)
            .toMap((p) -> p.name, (p) -> p.default),
      )
    chart = paths("", chartNode.cls, null)
    // The properties the schema requires and the defaults leave out: per class
    // (qname), and as chart paths.
    classesAtInstall =
      all.toMap(
        (n) -> n.cls.qname,
        (n) ->
          n.cls.props
            .filter((p) -> p.setAtInstall)
            .map((p) -> p.name),
      )
    chartAtInstall = atInstall("", chartNode.cls)
  }
}
